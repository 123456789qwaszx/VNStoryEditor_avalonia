<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Vn.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- 오디오 미리 듣기 (W62). 게임 런타임 오디오가 아니라 저작 확인용 재생이다. -->
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Vorbis" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 저작 도메인만 참조한다. Yarn 분석(Vn.Core)은 가져오기 도구의 것이지 편집기의 것이 아니다. -->
    <ProjectReference Include="..\Vn.Authoring\Vn.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vn.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기본 튜닝 (W46) — 런타임 실측 덤프의 스냅샷 데이터.
         '기본 튜닝 생성' 버튼이 이 내용을 프로젝트 옆 ExportedTuning으로 쓴다. -->
    <EmbeddedResource Include="Assets\DefaultTuning\**\*.json"
                      LogicalName="DefaultTuning/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    배포는 exe 하나로 (2026-08-17 — 비개발자에게 넘기기 위해).

    <b>디버그 심볼은 배포물에 넣지 않는다.</b> SkiaSharp·HarfBuzz의 네이티브 .pdb가
    합쳐서 100MB인데, 그건 exe(78MB)보다 크면서 쓰는 사람에게는 아무 소용이 없다.
    `DebugType=none`은 우리 어셈블리만 다스리므로 패키지가 딸려 보낸 것은 여기서 턴다.
  -->
  <Target Name="StripPublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>

    <Delete Files="@(PublishedSymbol)" />
  </Target>
</Project>
