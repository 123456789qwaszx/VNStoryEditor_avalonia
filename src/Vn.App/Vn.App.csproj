<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Vn.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- 오디오 미리 듣기 (W62). 게임 런타임 오디오가 아니라 저작 확인용 재생이다. -->
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Vorbis" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 저작 도메인만 참조한다. Yarn 분석(Vn.Core)은 가져오기 도구의 것이지 편집기의 것이 아니다. -->
    <ProjectReference Include="..\Vn.Authoring\Vn.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vn.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기본 튜닝 (W46) — 런타임 실측 덤프의 스냅샷 데이터.
         '기본 튜닝 생성' 버튼이 이 내용을 프로젝트 옆 ExportedTuning으로 쓴다. -->
    <EmbeddedResource Include="Assets\DefaultTuning\**\*.json"
                      LogicalName="DefaultTuning/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
