<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.BoxListView">
    <UserControl.DataTemplates>
        <DataTemplate DataType="views:BoxItem" x:DataType="views:BoxItem">
            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,6"
                    Background="{DynamicResource ThemeControlLowBrush}"
                    PointerPressed="OnBoxPressed">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Commands}"
                               IsVisible="{Binding HasCommands}"
                               FontFamily="Cascadia Mono,Consolas"
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="120,*">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Speaker, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsLocked}"
                                 FontWeight="SemiBold"
                                 PlaceholderText="화자"
                                 TextChanged="OnBoxEdited" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Text, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsLocked}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 TextChanged="OnBoxEdited" />
                    </Grid>

                    <TextBlock Text="{Binding Hashtags}"
                               IsVisible="{Binding HasHashtags}"
                               Opacity="0.65"
                               FontSize="11" />

                    <TextBlock Text="{Binding LockReason}"
                               IsVisible="{Binding IsLocked}"
                               Opacity="0.7"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="views:BranchItem" x:DataType="views:BranchItem">
            <Expander IsExpanded="True" Margin="0,0,0,6">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4">
                        <TextBlock Grid.Column="0" Text="{Binding Marker}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DestinationText}"
                                   IsVisible="{Binding HasDestination}"
                                   Opacity="0.65" />
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="6" Margin="16,2,0,0">
                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Opacity="0.85"
                            IsVisible="{Binding HasCommands}">
                        <TextBlock Text="{Binding Commands}"
                                   FontFamily="Cascadia Mono,Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Children}" />
                </StackPanel>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="views:BlockItem" x:DataType="views:BlockItem">
            <Border Margin="{Binding Indent}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               FontSize="11"
                               Margin="0,2,0,6" />
                    <ItemsControl ItemsSource="{Binding Branches}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Elements" Margin="12" />
    </ScrollViewer>
</UserControl>
