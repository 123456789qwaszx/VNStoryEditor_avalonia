<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.BoxListView">

    <!--
        템플릿을 컨트롤 수준에 두면 타입으로 찾아 쓴다.
        그래서 갈래 안의 ItemsControl이 다시 박스와 블록을 그릴 수 있다 — 중첩이 저절로 된다.
    -->
    <UserControl.DataTemplates>

        <!-- 박스: 쌓인 명령과 그것이 닫는 라인 하나. -->
        <DataTemplate DataType="views:BoxItem" x:DataType="views:BoxItem">
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,4"
                    Background="Transparent"
                    PointerPressed="OnBoxPressed">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Commands}"
                               IsVisible="{Binding HasCommands}"
                               FontFamily="Consolas"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                    <Border Height="1"
                            Background="Gray"
                            Opacity="0.4"
                            IsVisible="{Binding HasCommands}" />

                    <!-- 대사와 화자만 고칠 수 있다. 명령·라벨·태그는 읽기 전용이다.
                         고친 뒤 원본 줄을 그대로 되살릴 수 없는 박스는 잠근다. -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Speaker, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsLocked}"
                                 FontWeight="Bold"
                                 MinWidth="80"
                                 Margin="0,0,8,0"
                                 TextChanged="OnBoxEdited" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Text, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsLocked}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 TextChanged="OnBoxEdited" />
                    </Grid>

                    <TextBlock Text="{Binding Hashtags}"
                               IsVisible="{Binding HasHashtags}"
                               Opacity="0.7"
                               FontSize="11" />

                    <TextBlock Text="{Binding LockReason}"
                               IsVisible="{Binding IsLocked}"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 갈래: 접히는 카드. 머리에 라벨과 목적지를 둔다. -->
        <DataTemplate DataType="views:BranchItem" x:DataType="views:BranchItem">
            <Expander IsExpanded="True" Margin="0,0,0,4">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Marker}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DestinationText}"
                                   IsVisible="{Binding HasDestination}"
                                   Opacity="0.7" />
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="4">
                    <!-- 이 갈래에서 실행되는 명령. 갈래에 대사가 없으면 이것이 내용 전부다. -->
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Opacity="0.85"
                            IsVisible="{Binding HasCommands}">
                        <TextBlock Text="{Binding Commands}"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Children}" />
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- 블록: 갈래 카드를 모아 놓은 것. 중첩되면 왼쪽으로 들여쓴다. -->
        <DataTemplate DataType="views:BlockItem" x:DataType="views:BlockItem">
            <StackPanel Margin="{Binding Indent}">
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           Opacity="0.7"
                           FontSize="11"
                           Margin="0,4,0,4" />
                <ItemsControl ItemsSource="{Binding Branches}" />
            </StackPanel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Elements" />
    </ScrollViewer>
</UserControl>
