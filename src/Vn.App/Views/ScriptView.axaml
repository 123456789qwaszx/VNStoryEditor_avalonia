<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.ScriptView">

    <!-- [대본] — 작가의 자리 (R-E · 지시서 §6).
         ⛔ 노드도 포트도 없다. 이 화면이 보여 주는 것은 <b>글</b>뿐이고, 그것이
            이 탭이 연출 그래프 안이 아니라 밖에 선 이유다(§6.1). -->
    <Grid ColumnDefinitions="220,*">

        <!-- 왼쪽 — 챕터 → 에피소드 -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,2*" Margin="8">
            <TextBlock Grid.Row="0" Text="챕터" FontWeight="SemiBold" Margin="2,0,0,4" />
            <ListBox Grid.Row="1" x:Name="ChapterList" />

            <TextBlock Grid.Row="2" Text="에피소드" FontWeight="SemiBold" Margin="2,10,0,4" />
            <ListBox Grid.Row="3" x:Name="EpisodeList" />
        </Grid>

        <!-- 오른쪽 — 글 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="0,8,8,8">

            <TextBlock Grid.Row="0"
                       x:Name="HeaderText"
                       FontWeight="SemiBold"
                       Margin="2,0,0,6" />

            <Grid Grid.Row="1">

                <!-- AcceptsReturn — 여기는 글을 쓰는 자리다. Tab은 넘기지 않는다(들여쓰기 없음). -->
                <TextBox x:Name="ScriptBox"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         FontFamily="Consolas,D2Coding,monospace"
                         VerticalContentAlignment="Top" />

                <!-- 빈 자리의 사다리 — 챕터 그래프가 2026-08-26에 세운 그 규율의 다음 칸이다
                     (새 프로젝트 → ＋챕터 → ＋에피소드 → <b>＋대본</b>). 안내문만 서 있으면
                     다음 할 일이 글로만 남는다. 누를 자리가 한가운데 함께 선다.

                     ⚠ 판을 <b>덮는다</b>(투명하지 않다). 아직 대본이 없는 에피소드에서
                     빈 입력칸이 그냥 보이면 작가는 그것이 고장인지 빈 대본인지 못 가린다. -->
                <Border x:Name="EmptyPanel"
                        IsVisible="False"
                        Background="{DynamicResource ThemeBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <TextBlock x:Name="EmptyText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"
                                   MaxWidth="420" />
                        <Button x:Name="EmptyAddScriptButton"
                                Content="＋ 대본"
                                HorizontalAlignment="Center"
                                Padding="16,6"
                                IsVisible="False"
                                ToolTip.Tip="이 에피소드의 대본을 세웁니다 — 판에 대사노드가 서고, 쓴 글은 [글 반영]으로 워크북까지 나갑니다." />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="2,6,0,0">
                <TextBlock x:Name="ProblemsText"
                           IsVisible="False"
                           Foreground="IndianRed"
                           TextWrapping="Wrap" />

                <!-- ⚠ 미등록 화자는 <b>오류가 아니다</b>(지시서 §6.2) — 붉은색이 아닌 이유다.
                     작가가 등록부보다 앞서 쓰는 것은 정상이고, 등록은 기획자의 일이다.
                     그래도 조용히 넘어가지는 않는다: 초상화가 안 붙는다는 뜻이라서다. -->
                <TextBlock x:Name="UnknownSpeakerText"
                           IsVisible="False"
                           Opacity="0.65"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">

                <!-- 쓰는 동안 쓰는 도구라 [글 반영] 앞에 선다 — 왼쪽에서 오른쪽이 곧 순서다. -->
                <Button x:Name="SpeakerButton"
                        Content="화자 ▾"
                        ToolTip.Tip="등록된 화자를 지금 커서가 선 줄의 앞에 붙입니다. 목록의 원천은 game.definition.json이고, 기획자가 [챕터 그래프]의 [화자]에서 적습니다." />

                <Button x:Name="ApplyButton"
                        Content="글 반영"
                        ToolTip.Tip="쓴 글을 이 에피소드의 대사로 반영합니다. 기존 줄의 신원(LineId)은 내용이 바뀌어도 보존됩니다 — 연출·세이브가 그 신원에 매달려 있습니다." />

                <TextBlock x:Name="HintText"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
