<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.CommandSupplyNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="공급 노드 이름 (예: 카메라 노드)" />
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="공급 범주" FontWeight="SemiBold" />
                    <TextBlock Text="체크한 범주의 커맨드가 연결된 연출 노드의 드롭다운에 나타납니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="CategoryHost" Spacing="2" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="커맨드 프리셋" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddPresetButton" Content="프리셋 추가" FontSize="11" />
                    </Grid>
                    <TextBlock Text="값이 세팅된 커맨드입니다. 발행 시에는 해석된 최종 인자만 결과에 얼어붙습니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="PresetHost" Spacing="6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="연결된 연출 노드" FontWeight="SemiBold" />
                    <TextBlock Text="체크하면 이 노드가 그 연출 노드에 범주와 프리셋을 공급합니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="LinkHost" Spacing="2" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
