<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vn.App.Views.StagePreviewWindow"
        Title="무대 프리뷰"
        Width="1024"
        Height="680"
        MinWidth="480"
        MinHeight="320"
        Background="Black">
    <Grid RowDefinitions="*,Auto">
        <ContentControl Grid.Row="0" x:Name="SceneHost" />

        <Border Grid.Row="1"
                Background="#FF26262E"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <!-- 검은 무대 위 조작 바 — 기본 테마 버튼이 어두워 묻히므로 여기서만 밝게 고정한다. -->
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="#FF44444F" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FF5A5A66" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#99FFFFFF" />
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FF33333B" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FF2E2E35" />
                    <Setter Property="Foreground" Value="#55FFFFFF" />
                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                </Style>
                <Style Selector="ToggleButton">
                    <Setter Property="Background" Value="#FF44444F" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
                <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FF5A5A66" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FFFACC15" />
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </Border.Styles>
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <ToggleButton Grid.Column="0"
                                  x:Name="FollowToggle"
                                  Content="따라가기"
                                  IsChecked="True"
                                  FontSize="11"
                                  Padding="8,3" />
                    <Button Grid.Column="1"
                            x:Name="PrevButton"
                            Content="◀ 이전"
                            FontSize="11"
                            Padding="8,3"
                            Margin="10,0,0,0" />
                    <Button Grid.Column="2"
                            x:Name="NextButton"
                            Content="다음 ▶"
                            FontSize="11"
                            Padding="8,3"
                            Margin="4,0,0,0" />
                    <!-- 재생 컨트롤 (W31) — 도킹 패널과 같은 StagePlayback 하나를 본다. -->
                    <ContentControl Grid.Column="3"
                                    x:Name="PlaybackHost"
                                    Margin="10,0,0,0" />
                    <TextBlock Grid.Column="4"
                               x:Name="PositionText"
                               FontSize="11"
                               Foreground="White"
                               Opacity="0.85"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- 뱃지·갈래 칩은 제 줄을 가진다 — 위치 텍스트와 겹치지 않고, 많으면 줄바꿈한다 (W37). -->
                <WrapPanel x:Name="BadgeRow" />

                <StackPanel x:Name="NoticeHost" Spacing="2" />
                <StackPanel x:Name="UnhandledHost" Spacing="2" IsVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
