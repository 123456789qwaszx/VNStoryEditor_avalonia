<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.ChapterGraphView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="챕터"
                           FontSize="11"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" x:Name="ChapterCombo" MinWidth="180" />
                <Button Grid.Column="2" x:Name="ReloadButton" Content="다시 읽기" Margin="6,0,0,0" />
                <Button Grid.Column="3" x:Name="OpenFolderButton" Content="폴더 열기" Margin="6,0,0,0" />
                <!-- [내보내기] 단추는 없앴다 (2026-08-17 소유자: "필요 없어 보이는데").
                     작가의 Yarn이 LiveOutputService로 저절로 나가는데 챕터 진행 JSON만
                     사람 손을 기다리면, 누른 순간의 낡은 파일이 디스크에 남는다. 이제
                     다시 읽을 때마다 저절로 나간다 — G8의 거부 규칙은 그대로다. -->
                <Button Grid.Column="5"
                        x:Name="AddEpisodeButton"
                        Content="＋ 에피소드"
                        Margin="6,0,0,0"
                        ToolTip.Tip="선택된 에피소드의 다음으로 새 에피소드를 만들어 잇습니다. 선택이 없으면 홀로 섭니다. 이름은 우측 [개명]으로." />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            Spacing="6">
                    <TextBlock Text="픽스처"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center" />
                    <!-- 재생루트 하이라이트 (G6). 2026-08-16 소유자 — 당장 안 쓰니 임시 숨김.
                         코드·리더는 그대로다 — 되살릴 때 IsVisible만 돌리면 된다. -->
                    <ComboBox x:Name="FixtureCombo" MinWidth="130" FontSize="11" IsVisible="False" />
                    <TextBlock x:Name="FixtureStopText"
                               FontSize="10"
                               Opacity="0.7"
                               Foreground="DarkGoldenrod"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 기본 동작 = 엑셀에서만 편집, 툴은 보여준다 (2026-08-16 소유자).
                     체크를 풀면 툴 편집이 열리고, 편집은 여전히 엑셀 셀에 즉시 저장된다(G-2 v2).
                     그 오른쪽 끝이 파괴적 동작의 자리다 — 빨갛게, 편집이 열렸을 때만 보인다. -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="10">
                    <CheckBox x:Name="ExcelOnlyCheck"
                              Content="엑셀에서만 편집"
                              FontSize="11"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              ToolTip.Tip="켜져 있으면 툴은 읽기 전용입니다 — 모든 데이터는 엑셀에서 만집니다. 풀면 개명·간선·선택지를 툴에서도 고칠 수 있고, 고친 값은 엑셀 셀에 바로 저장됩니다.&#x0A;엑셀이 그 챕터 파일을 열고 있으면 이 체크는 잠깁니다 — 그때는 툴이 아무것도 쓸 수 없습니다." />
                    <!-- 삭제는 늘 같은 자리에 있다 (2026-08-16 소유자) — 체크를 풀 때
                         갑자기 튀어나오면 그 자리를 누르던 손이 삭제를 누른다(실사례).
                         평소엔 회색·비활성, 편집을 열 때만 빨갛게 살아난다. -->
                    <Button x:Name="DeleteEpisodeButton"
                            Content="에피소드 삭제"
                            FontSize="11"
                            VerticalAlignment="Center"
                            ToolTip.Tip="선택한 에피소드의 행과 그 에피소드를 오가는 간선을 함께 지웁니다. 대본 엑셀 파일과 챕터의 선택지 문구는 그대로 둡니다." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 340 — 메인 우측 열이 챕터 모드에서 접히며 얻은 폭의 일부를 패널에 준다.
             조건 식·대사 미리보기가 300에서는 줄바꿈으로 부서졌다. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,340">
            <Grid Grid.Column="0">
                <!-- 휠 확대·축소 / 가운데 단추 끌어 이동 (2026-08-17 소유자, Ctrl 요구는 2026-08-18 해제).
                     연출 그래프와 같은 손놀림이다 — 판이 둘인데 다루는 법이 다르면
                     손이 매번 헷갈린다. 배율은 ZoomHost의 LayoutTransform이 진다:
                     캔버스 좌표(배치·간선 산식)는 배율을 몰라도 된다. -->
                <ScrollViewer x:Name="GraphScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl x:Name="ZoomHost">
                        <Canvas x:Name="GraphCanvas" Background="Transparent" />
                    </LayoutTransformControl>
                </ScrollViewer>

                <!-- 배율 표시 — 100%가 아닐 때만. 누르면 100%로 돌아온다. -->
                <Button x:Name="ZoomResetButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,18"
                        Padding="8,3"
                        FontSize="11"
                        IsVisible="False"
                        ToolTip.Tip="배율을 100%로 되돌립니다. 휠로 확대·축소, 가운데 단추를 끌어 이동합니다.">
                    <TextBlock x:Name="ZoomText" />
                </Button>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 오른쪽 패널 (G-2 v3) — 소량 편집은 여기서, 대량(대사)은 엑셀에서.
                 모든 [적용]은 엑셀 셀에 써지고, 저장 감시가 다시 읽어 그래프가 따라온다.

                 두 탭으로 나눈 이유: 조건은 챕터 전체에 걸린 표(선택과 무관)이고,
                 편집은 지금 고른 하나에 걸린다. 섞여 있으면 조건을 보려고 매번 스크롤해야 했다.
                 조건이 앞 탭이다 — 흐름을 잇기 전에 조건부터 정의하는 순서라서. -->
            <!-- ⚠ 스플리터 아래는 <b>별(*) 행 하나</b>여야 한다 (2026-08-22 소유자 보고:
                 "위로만 움직이고 아래쪽으로는 동작을 안 하는"). 처음엔 `200,6,Auto,*`라
                 스플리터 바로 아래가 잠금 배너(Auto)였다 — 아래로 끌면 목록을 늘리려고
                 Auto 행을 줄여야 하는데 Auto는 이미 내용 높이라 더 줄 것이 없어 멈췄고,
                 위로 끌 때만 그 행이 늘며 움직였다. 배너와 탭을 안쪽 격자로 묶어
                 스플리터의 상대가 별 행이 되게 한다. -->
            <Grid Grid.Column="2" x:Name="ChapterRightRows">
                <Grid.RowDefinitions>
                    <!-- 목록: 사람이 끄는 높이. 최소 90 — 0까지 끌어 사라지면 다시 잡을
                         손잡이가 없다. -->
                    <RowDefinition Height="200" MinHeight="90" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- 챕터 목록이 여기로 이사했다 (2026-08-22 소유자) — 예전에는 창 맨 왼쪽에
                     제 열 하나를 갖고 있었다. 챕터를 고르는 일과 그 챕터를 편집하는 일이
                     한 기둥에 서고, 그래프는 그만큼 넓어진다. 목록이 차지하는 높이는
                     아래 스플리터로 사람이 정한다.
                     ⚠ 내용은 MainWindow가 짓는다(아래 세 손잡이) — 목록 클릭이 세션 전환·
                     엑셀 열기와 얽혀 있어 뷰로 옮기면 배선이 두 벌이 된다. -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Padding="10,8"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="챕터" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ChapterSummary"
                                               FontSize="11"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="AddChapterButton"
                                        Content="＋"
                                        FontSize="12"
                                        Padding="7,2"
                                        VerticalAlignment="Top"
                                        ToolTip.Tip="새 챕터 — chapters/ 폴더에 규격 워크북을 만들고 판을 엽니다." />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChapterListPanel" Margin="8,8,8,10" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              Background="{DynamicResource ThemeBorderLowBrush}" />

                <!-- 배너 + 탭은 한 덩어리다 — 스플리터의 상대가 이 격자(별 행) 하나여야
                     아래로도 끌린다. 배너가 떴다 사라져도 목록 높이는 안 흔들린다. -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*">

                <!-- 엑셀이 챕터 파일을 열고 있으면 툴의 모든 쓰기가 거부된다 (2026-08-16
                     실사례: 챕터 더블클릭으로 엑셀을 연 뒤 툴에서 고치려다 전부 막혔다).
                     누르기 전에 화면이 먼저 말한다 — 상태줄 한 줄은 묻힌다. -->
                <Border x:Name="LockBanner"
                        Grid.Row="0"
                        IsVisible="False"
                        Background="#FDECEA"
                        BorderBrush="#E6B0AA"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <TextBlock x:Name="LockBannerText"
                               FontSize="11"
                               Foreground="#922B21"
                               TextWrapping="Wrap" />
                </Border>

            <TabControl Grid.Row="1" x:Name="RightTabs" Padding="0">
                <!-- [챕터] — 판 전체에 걸린 표들. 조건은 여기서 편집하고(원천은 조건 시트),
                     스탯·픽스처는 어디에서도 값이 안 보이던 것들이라 읽기 전용으로 세운다.
                     에피소드·간선은 그래프가 이미 그리므로 여기 반복하지 않는다. -->
                <TabItem x:Name="ConditionTab" Header="챕터" FontSize="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConditionSection" Margin="10" Spacing="4">
                            <!-- 조건은 읽기 전용 표다 (2026-08-16 소유자 — 툴 편집 UI 제거).
                                 편집은 챕터 엑셀의 `조건` 시트에서 — 스탯·연산자 드롭다운으로 조립한다. -->
                            <TextBlock Text="조건 (라벨 ↔ 식)"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="편집은 챕터 엑셀의 `조건` 시트에서 합니다 — 스탯과 연산자는 드롭다운, 값은 정수(bool은 true/false)입니다. 에피소드·간선은 여기 라벨만 부릅니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <StackPanel x:Name="ConditionListPanel" Spacing="2" />

                            <TextBlock Text="스탯"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="존재는 game.definition.json이, 값(초기·최소·최대)은 스탯 시트가 소유합니다. 여기서는 읽기만 합니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="StatListPanel" Spacing="2" />

                            <!-- 픽스처 — 2026-08-16 소유자 임시 제거. 되살릴 때 IsVisible만 돌린다. -->
                            <StackPanel x:Name="FixtureSection" IsVisible="False">
                                <TextBlock Text="픽스처"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="재생루트를 눈으로 보기 위한 테스트 데이터 — 내보내기에 섞이지 않습니다. 전환은 툴바의 픽스처 콤보입니다."
                                           FontSize="10"
                                           Opacity="0.55"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="FixtureListPanel" Spacing="2" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="EditTab" Header="편집" FontSize="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="6">
                    <TextBlock x:Name="NoSelectionText"
                               Text="노드 클릭 = 선택 · 더블클릭 = 대본 엑셀 열기&#x0A;선택한 뒤 [＋ 에피소드] = 다음 에피소드로 잇기&#x0A;선(길) 클릭 = 표시·해금조건과 스탯변화 편집"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="PropertyPanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="에피소드" FontWeight="SemiBold" FontSize="12" />

                        <!-- 개명 = Id를 고치고 Enter (2026-08-16 — 단추 대신 자동 반영).
                             제목·엔딩키·메모 칸은 소유자 지시로 뺐다 — 그 값들은 엑셀에서.

                             ⚠ 2026-08-24 소유자 보고 "이름을 바꾸는 게 가능하도록 해줘" —
                             기능은 처음부터 있었는데 **머리글이 그냥 '에피소드'이고 칸이
                             읽기 전용 표시처럼 보여** 아무도 개명 자리인 줄 몰랐다.
                             기능을 더한 것이 아니라 이름표를 붙였다. -->
                        <TextBlock x:Name="IdBoxHint" Text="이름 — 고치고 Enter" FontSize="10" Opacity="0.6" />
                        <TextBox x:Name="IdBox" FontSize="11" PlaceholderText="EpisodeId"
                                 ToolTip.Tip="이름을 고치고 Enter를 누르면 개명됩니다 — 간선·픽스처·대본 파일·대사 노드가 함께 따라갑니다. 조건식의 cleared: 참조가 있으면 거부됩니다." />

                        <!-- 표시·해금조건은 v8에서 간선으로 옮겨 갔다 ("보일지 말지는 길이 정한다").
                             컨트롤은 남기되 감춘다 — 후속 정리·테스트가 참조한다. -->
                        <ComboBox x:Name="VisibleCombo" IsVisible="False" />
                        <ComboBox x:Name="UnlockCombo" IsVisible="False" />

                        <!-- 읽기 전용 값(대사엔트리·종류 등) — 고치는 곳은 엑셀. -->
                        <TextBlock x:Name="EpisodeFactsText"
                                   FontSize="10"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <!-- 선택지 — 이 에피소드에서 나가는 길들 (v9). 길 하나 = 선택지 하나.
                             [＋]로 길을 하나 열고, 줄을 클릭하면 그 줄 바로 아래에서 문구와
                             도착을 고친다. 문구는 챕터 엑셀 `선택지` 시트의 사전에서 고른다. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock x:Name="ChoiceHeaderText" Text="선택지" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="AddNextEdgeButton" Content="＋"
                                    FontSize="11" Padding="7,1"
                                    ToolTip.Tip="선택지를 하나 엽니다 — 문구와 도착을 골라 잇습니다. 문구는 챕터 엑셀 `선택지` 시트에서 만듭니다." />
                        </Grid>
                        <TextBlock Text="길 하나 = 선택지 하나. 문구는 챕터의 사전에서 고르고, 어느 에피소드에서든 같은 문구를 씁니다. 문구가 없는 길은 보이지 않는 기본입니다."
                                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        <StackPanel x:Name="EdgeListPanel" Spacing="3">
                            <!-- 잇기 폼 — 코드가 목록 안에서 자리를 옮긴다(클릭한 줄 바로 아래).
                                 문구 드롭다운은 <b>챕터 전체의 사전</b>이다 (v9, 2026-08-17
                                 소유자: "자기 것만 고르는 게 아니라 모든 선택지 중에서
                                 자유자재로"). 안 고쳐도 무엇이 있는지 보이는 것이 값이다. -->
                            <!-- 한 줄 폼 (2026-08-16 소유자) — 선택지 · 도착 · 수정을 한 줄에
                                 둔다. 두 줄로 접히면 목록의 흐름이 끊긴다. -->
                            <!-- 툴팁 없음 (2026-08-16 소유자) — 목록 위에 뜨는 설명 상자가
                                 화면을 가렸다. 자리표시 글(선택지·도착)로 충분하다. -->
                            <!-- 읽는 순서가 곧 뜻이다 (2026-08-16 소유자):
                                 [이 선택지를 고르면] → [여기로 간다]. 화살표가 그 관계다. -->
                            <!-- 폼 = 배선 한 줄 + 스탯변화 줄들. 2026-08-17 소유자: 스탯 수치를
                                 에피소드 노드에서 바로 만질 수 있어야 한다. 값이 사는 곳은
                                 그대로 그 길(간선)이다 — 손만 여기로 왔다. -->
                            <StackPanel x:Name="EdgeFormHost" Spacing="4" IsVisible="False">
                            <Grid x:Name="EdgeFormPanel" ColumnDefinitions="*,Auto,*,Auto" IsVisible="False">
                                <!-- 도착이 먼저다 (2026-08-24 소유자). 길을 놓을 때 사람이
                                     먼저 정하는 것은 "어디로 가나"이고, 문구는 그 다음이다.
                                     화살표를 ←로 뒤집어 관계는 그대로 읽히게 둔다:
                                     "이 도착지로 ← 이 선택지를 눌러서". -->
                                <ComboBox Grid.Column="0" x:Name="EdgeTargetCombo" FontSize="11"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="도착" />
                                <TextBlock Grid.Column="1"
                                           Text="←"
                                           FontSize="12"
                                           Opacity="0.55"
                                           Margin="6,0"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" x:Name="EdgeLabelBox" FontSize="11"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="선택지" />
                                <Button Grid.Column="3" x:Name="AddEdgeButton" Content="수정" FontSize="11" Margin="4,0,0,0" />
                            </Grid>
                            <TextBlock Text="스탯변화 — 이 길을 건너면" FontSize="10" Opacity="0.6" />
                            <StackPanel x:Name="EdgeFormStatsHost" Spacing="3" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 대사 미리보기 — 선택지 아래에 접어 둔다 (2026-08-16 소유자:
                             "에피소드 노드의 정보량이 부족하다"). 원천은 방금 읽은 대본
                             워크북이고, 고치는 곳은 엑셀이다. 별도 탭이던 것을 여기로 합쳤다. -->
                        <!-- 대사 — 상자를 겹치지 않는다 (2026-08-16 소유자 재지시).
                             Expander·테두리·안쪽 스크롤을 걷어냈다: 탭 속의 탭처럼 보이고
                             읽는 폭만 좁혔다. 지금은 **얇은 구분선 + 접기 토글 + 흐르는 글**
                             뿐이고, 스크롤은 편집 탭 하나만 쓴다. 대사를 고치며 읽는 화면이라
                             가독성이 가장 위다. -->
                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,14,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- 삼각형이 접힘/펼침을 말한다 (2026-08-16 소유자) —
                                         ▸ 접힘 · ▾ 펼침. 코드가 상태에 맞춰 글자를 바꾼다. -->
                                    <ToggleButton x:Name="DialogueToggle"
                                                  Content="▸  대사"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <!-- 켜져도 파랗게 칠하지 않는다 (2026-08-16 소유자:
                                             "파란색은 빼. 거슬려") — 테마 기본 ToggleButton은
                                             체크되면 강조색으로 채워진다. 제목처럼 보여야 하는
                                             자리라 모든 상태에서 평평하게 둔다. -->
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1"
                                               x:Name="DialoguePreviewHeader"
                                               FontSize="10"
                                               Opacity="0.55"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- 한 덩어리로 흐르는 글. 화자는 줄 앞에 그대로 붙는다
                                     (`윌로: 복도는 조용했다`) — 줄마다 카드로 가르면
                                     읽기가 오히려 나빠진다(2026-08-16 실사용 판정). -->
                                <SelectableTextBlock x:Name="DialoguePreviewText"
                                                     FontSize="12"
                                                     LineHeight="20"
                                                     TextWrapping="Wrap"
                                                     IsVisible="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 길(간선) 편집 — 그래프에서 선을 클릭하면 여기가 열린다. 선택지형 VN의
                         "이 선택지는 언제 보이고 언제 열리는가"를 여기서 정한다. -->
                    <StackPanel x:Name="EdgePanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="선택지가 가는 길" FontWeight="SemiBold" FontSize="12" />
                        <!-- 양 끝 에피소드는 누를 수 있다 — 간선을 보다가 "저 에피소드 이름을
                             고쳐야겠다"가 되는 흐름이 실제 저작의 대부분이다. -->
                        <StackPanel x:Name="EdgeFromToPanel" Orientation="Horizontal" Spacing="4" />

                        <TextBlock Text="선택지 — 이 길에 붙는 문구" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeLabelEditBox" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="챕터의 모든 문구 중에서 고릅니다 — 문구는 어느 에피소드에서든 다시 씁니다. 새 문구는 챕터 엑셀 `선택지` 시트에 적으면 여기 목록에 옵니다. 문구가 없으면 보이지 않는 기본(버튼 없이 자동 진행, 에피소드당 하나)입니다." />

                        <TextBlock Text="표시조건 — 이 선택지가 보이려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeVisibleCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="미달이면 선택지가 목록에 아예 안 뜹니다. 비우면 언제나 보입니다." />

                        <TextBlock Text="해금조건 — 보이지만 고를 수 있으려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeConditionCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="미달이면 잠긴 채 보이고 아래 안내문이 뜹니다(잠기면 숨김을 켜면 숨습니다)." />

                        <CheckBox x:Name="EdgeHideCheck" Content="해금 미달이면 숨김" FontSize="11"
                                  ToolTip.Tip="켜면 조건 미달일 때 선택지 자체가 안 보입니다. 끄면 잠긴 채 보이고 아래 안내문이 뜹니다." />
                        <TextBox x:Name="EdgeLockedMsgBox" FontSize="11"
                                 PlaceholderText="잠금 안내문 — 잠긴 채 보일 때 (예: 신뢰가 부족하다)" />

                        <!-- 스탯이 변하는 유일한 자리 (2026-08-14) — 이 간선을 타는 순간 1회 커밋.
                             2026-08-17 소유자: 문법을 외우는 칸이 아니라 고르는 줄로. 스탯은
                             엑셀 `스탯` 시트에서 선언한 것만 드롭다운에 온다. -->
                        <TextBlock Text="스탯변화 — 이 길을 고르면" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <StackPanel x:Name="EdgeStatsHost" Spacing="3" />

                        <!-- [적용]은 없앴다 (2026-08-17 소유자: "굳이 적용을 누르지 않아도
                             바로 반영되도록"). 고르는 순간 그 셀이 써진다 — 글자 칸만
                             초점을 잃거나 Enter일 때 낸다. -->
                        <TextBlock Text="고치면 그 자리에서 엑셀에 저장됩니다."
                                   FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                        <Button x:Name="EdgeDeleteButton" Content="이 길 끊기" HorizontalAlignment="Stretch"
                                ToolTip.Tip="간선 행을 지웁니다. 문구는 챕터 사전에 남습니다 — 다른 길에서 다시 씁니다." />
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- [화자] — 프로젝트 전체의 캐스트 (2026-08-23 소유자: "이 화자탭에서 화자
                     추가 삭제를 하는 것이 구조적으로 옳다. 여기서 추가한 화자는 게임
                     project에 저장되며, 모든 챕터가 공유해서 쓴다").

                     ⚠ 챕터 워크북의 `화자` 시트는 폐지됐다 — 챕터 엑셀의 어느 시트도 화자를
                     쓰지 않았으므로 애초에 거기 있을 이유가 없었다. 이 탭이 유일한 등록
                     창구이고, 값은 game.definition.json의 speakers에 산다. -->
                <TabItem x:Name="SpeakerTab" Header="화자" FontSize="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="4">
                            <TextBlock Text="화자 (캐스트)"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock x:Name="SpeakerHintText"
                                       Text="모든 챕터가 같은 목록을 씁니다 — game.definition.json에 저장됩니다. 캐릭터키를 채우면 초상화·표정이 붙습니다(비워도 됩니다)."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <!-- 한 줄 폼 — 선택지 폼과 같은 규칙이다. -->
                            <Grid ColumnDefinitions="*,*,Auto">
                                <TextBox x:Name="SpeakerNameBox"
                                         Grid.Column="0"
                                         FontSize="12"
                                         PlaceholderText="이름" />
                                <TextBox x:Name="SpeakerCharacterIdBox"
                                         Grid.Column="1"
                                         Margin="6,0,0,0"
                                         FontSize="12"
                                         PlaceholderText="캐릭터키 (선택)" />
                                <Button x:Name="SpeakerAddButton"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        FontSize="11"
                                        Content="＋ 추가"
                                        ToolTip.Tip="Enter로도 더합니다. 같은 이름은 한 번만 섭니다." />
                            </Grid>

                            <StackPanel x:Name="SpeakerListPanel" Spacing="2" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <Expander x:Name="DiagnosticsExpander"
                      Header="검증 보고"
                      Padding="0"
                      HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <!-- 보고를 그대로 들고 나갈 수 있어야 한다 — 협업자·세션에 붙여넣는 용도. -->
                    <Button Grid.Row="0"
                            x:Name="CopyDiagnosticsButton"
                            Content="보고 복사"
                            FontSize="10"
                            Padding="8,2"
                            Margin="10,4,10,0"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="아래 목록 전체를 클립보드로 복사합니다. 줄 하나만 필요하면 드래그로 선택해도 됩니다." />
                    <!-- AllowAutoHide=False — 목록이 길 때 "아래 더 있다"가 보여야 한다.
                         숨는 오버레이 스크롤바는 동기화 보고가 묻혀 있다는 사실 자체를 숨겼다(실사례). -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel x:Name="DiagnosticsPanel" Margin="10,6" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
