<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.ChapterGraphView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="챕터"
                           FontSize="11"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" x:Name="ChapterCombo" MinWidth="180" />
                <Button Grid.Column="2" x:Name="ReloadButton" Content="다시 읽기" Margin="6,0,0,0" />
                <Button Grid.Column="3" x:Name="OpenFolderButton" Content="폴더 열기" Margin="6,0,0,0" />
                <!-- G8 — 검증을 통과해야만 나간다. 오류가 있으면 거부하고 사유를 보고 패널에 세운다. -->
                <Button Grid.Column="4"
                        x:Name="ExportButton"
                        Content="내보내기"
                        Margin="6,0,0,0"
                        ToolTip.Tip="런타임 수입용 JSON을 exported/ 폴더에 씁니다. 검증 오류가 있으면 거부됩니다." />
                <Button Grid.Column="5"
                        x:Name="AddEpisodeButton"
                        Content="＋ 에피소드"
                        Margin="6,0,0,0"
                        ToolTip.Tip="선택된 에피소드의 다음으로 새 에피소드를 만들어 잇습니다. 선택이 없으면 홀로 섭니다. 이름은 우측 [개명]으로." />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            Spacing="6">
                    <TextBlock Text="픽스처"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center" />
                    <!-- 재생루트 하이라이트 (G6). 2026-08-16 소유자 — 당장 안 쓰니 임시 숨김.
                         코드·리더는 그대로다 — 되살릴 때 IsVisible만 돌리면 된다. -->
                    <ComboBox x:Name="FixtureCombo" MinWidth="130" FontSize="11" IsVisible="False" />
                    <TextBlock x:Name="FixtureStopText"
                               FontSize="10"
                               Opacity="0.7"
                               Foreground="DarkGoldenrod"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- G-2 v2 — 엑셀이 원본이고 툴 편집은 해당 셀에 즉시 저장된다. -->
                <Border Grid.Column="8"
                        Padding="7,3"
                        CornerRadius="3"
                        Background="#22808080">
                    <TextBlock Text="엑셀이 원본 · 편집은 엑셀 셀에 저장됩니다"
                               FontSize="10"
                               Opacity="0.75" />
                </Border>
            </Grid>
        </Border>

        <!-- 340 — 메인 우측 열이 챕터 모드에서 접히며 얻은 폭의 일부를 패널에 준다.
             조건 식·대사 미리보기가 300에서는 줄바꿈으로 부서졌다. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,340">
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="GraphScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="GraphCanvas" Background="Transparent" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 오른쪽 패널 (G-2 v3) — 소량 편집은 여기서, 대량(대사)은 엑셀에서.
                 모든 [적용]은 엑셀 셀에 써지고, 저장 감시가 다시 읽어 그래프가 따라온다.

                 두 탭으로 나눈 이유: 조건은 챕터 전체에 걸린 표(선택과 무관)이고,
                 편집은 지금 고른 하나에 걸린다. 섞여 있으면 조건을 보려고 매번 스크롤해야 했다.
                 조건이 앞 탭이다 — 흐름을 잇기 전에 조건부터 정의하는 순서라서. -->
            <TabControl Grid.Column="2" x:Name="RightTabs" Padding="0">
                <!-- [챕터] — 판 전체에 걸린 표들. 조건은 여기서 편집하고(원천은 조건 시트),
                     스탯·픽스처는 어디에서도 값이 안 보이던 것들이라 읽기 전용으로 세운다.
                     에피소드·간선은 그래프가 이미 그리므로 여기 반복하지 않는다. -->
                <TabItem x:Name="ConditionTab" Header="챕터" FontSize="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConditionSection" Margin="10" Spacing="4">
                            <!-- 조건 시트 편집 — 라벨이 이미 있으면 수정, 없으면 추가.
                                 식의 내용은 검증기가 잡는다. -->
                            <TextBlock Text="조건 (라벨 ↔ 식)"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="식은 여기서 한 번만 정의하고, 에피소드·간선에서는 라벨로만 부릅니다. 식을 고치면 그 라벨을 쓰는 곳이 전부 따라 바뀝니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <StackPanel x:Name="ConditionListPanel" Spacing="2" />
                            <TextBox x:Name="ConditionLabelBox" FontSize="11" PlaceholderText="라벨 — 예: 신뢰높음" />
                            <TextBox x:Name="ConditionExprBox" FontSize="11"
                                     PlaceholderText="식 — 예: trust >= 3 · flag == true (AND는 ;)"
                                     ToolTip.Tip="쓸 수 있는 연산자는 &gt;= · &lt;= · == · &gt; · &lt; 이고 값은 정수(bool 스탯은 true/false)입니다. 에피소드 클리어는 cleared:EpisodeId 입니다. 시트에는 스탯·연산자·값 세 칸으로 저장됩니다." />
                            <Button x:Name="SaveConditionButton" Content="조건 추가/수정" HorizontalAlignment="Stretch" FontSize="11" />

                            <TextBlock Text="스탯"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="존재는 game.definition.json이, 값(초기·최소·최대)은 스탯 시트가 소유합니다. 여기서는 읽기만 합니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="StatListPanel" Spacing="2" />

                            <!-- 픽스처 — 2026-08-16 소유자 임시 제거. 되살릴 때 IsVisible만 돌린다. -->
                            <StackPanel x:Name="FixtureSection" IsVisible="False">
                                <TextBlock Text="픽스처"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="재생루트를 눈으로 보기 위한 테스트 데이터 — 내보내기에 섞이지 않습니다. 전환은 툴바의 픽스처 콤보입니다."
                                           FontSize="10"
                                           Opacity="0.55"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="FixtureListPanel" Spacing="2" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="EditTab" Header="편집" FontSize="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="6">
                    <TextBlock x:Name="NoSelectionText"
                               Text="노드 클릭 = 선택 · 더블클릭 = 대본 엑셀 열기&#x0A;선택한 뒤 [＋ 에피소드] = 다음 에피소드로 잇기&#x0A;간선(선·라벨) 클릭 = 조건·해금 편집"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="PropertyPanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="에피소드" FontWeight="SemiBold" FontSize="12" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="IdBox" FontSize="11" PlaceholderText="EpisodeId" />
                            <Button Grid.Column="1" x:Name="RenameButton" Content="개명" FontSize="11"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="간선·픽스처 참조가 함께 따라갑니다. 조건식의 cleared: 참조가 있으면 거부됩니다." />
                        </Grid>

                        <!-- 값 편집 복원 (2026-08-15 소유자) — v3의 최소화가 테스트 편의였는데
                             실사용에서 편집 창구를 가렸다. 쓰기는 여전히 그 셀 하나다(G-2 v2). -->
                        <TextBox x:Name="TitleBox" FontSize="11"
                                 PlaceholderText="제목 — 카드에 표시 (비면 Id가 보임)"
                                 Margin="0,4,0,0" />

                        <TextBlock Text="표시조건 — 목록에 보이려면" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <ComboBox x:Name="VisibleCombo" FontSize="11" HorizontalAlignment="Stretch" />
                        <TextBlock Text="해금조건 — 고를 수 있으려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="UnlockCombo" FontSize="11" HorizontalAlignment="Stretch" />

                        <Grid ColumnDefinitions="*,6,*" Margin="0,4,0,0">
                            <TextBox Grid.Column="0" x:Name="EndingKeyBox" FontSize="11"
                                     PlaceholderText="엔딩키"
                                     ToolTip.Tip="적으면 이 에피소드가 엔딩 후보가 됩니다." />
                            <TextBox Grid.Column="2" x:Name="MemoBox" FontSize="11"
                                     PlaceholderText="메모" />
                        </Grid>

                        <Button x:Name="ApplyEpisodeButton" Content="적용"
                                HorizontalAlignment="Stretch" FontSize="11" Margin="0,4,0,0"
                                ToolTip.Tip="바뀐 값만 챕터 엑셀의 해당 셀에 씁니다." />

                        <!-- 남은 읽기 전용 값(인덱스·종류·대사엔트리 등) — 고치는 곳은 엑셀. -->
                        <TextBlock x:Name="EpisodeFactsText"
                                   FontSize="10"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="다음 에피소드" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" />
                        <!-- 목록의 줄을 클릭하면 그 간선이 선택되어 조건·해금을 편집한다.
                             새 분기는 툴바 [＋ 에피소드](선택된 노드의 자식으로)가 만든다. -->
                        <StackPanel x:Name="EdgeListPanel" Spacing="3" />

                        <!-- 이미 있는 에피소드로 잇기 (합류·순환). 라벨은 자유 입력이 아니라
                             대본의 OPTION에서 고른다 (2026-08-15 소유자) — 오타 = 유령 간선. -->
                        <Grid ColumnDefinitions="*,6,*,Auto">
                            <ComboBox Grid.Column="0" x:Name="EdgeTargetCombo" FontSize="11" />
                            <ComboBox Grid.Column="2" x:Name="EdgeLabelBox" FontSize="11"
                                      PlaceholderText="선택지"
                                      ToolTip.Tip="대본에 선택지가 있으면 그 OPTION 중에서 고릅니다(안 이은 옵션 = 종료). 선택지가 없으면 (선택지 없음) 하나 — 무조건 진행입니다." />
                            <Button Grid.Column="3" x:Name="AddEdgeButton" Content="연결" FontSize="11" Margin="4,0,0,0"
                                    ToolTip.Tip="이미 있는 에피소드를 다음으로 잇습니다." />
                        </Grid>

                        <Button x:Name="DeleteEpisodeButton"
                                Content="에피소드 삭제"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                ToolTip.Tip="행과 그 간선·픽스처 참조를 함께 지웁니다. 에피소드 엑셀 파일은 지우지 않습니다." />
                    </StackPanel>

                    <!-- 간선 편집 — 그래프에서 간선을 클릭하면 여기가 열린다. 선택지형 VN의
                         "이 분기는 언제 보이고 언제 열리는가"를 여기서 정한다. -->
                    <StackPanel x:Name="EdgePanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="간선" FontWeight="SemiBold" FontSize="12" />
                        <!-- 양 끝 에피소드는 누를 수 있다 — 간선을 보다가 "저 에피소드 이름을
                             고쳐야겠다"가 되는 흐름이 실제 저작의 대부분이다. -->
                        <StackPanel x:Name="EdgeFromToPanel" Orientation="Horizontal" Spacing="4" />

                        <TextBlock Text="선택지 — 출발 에피소드 대본의 OPTION" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeLabelEditBox" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="플레이어가 보는 버튼 글자 — 출발 에피소드 대본의 OPTION에서 고릅니다. 선택지가 없는 에피소드만 (선택지 없음) = 무조건 진행." />

                        <TextBlock Text="조건 — 이 분기를 고를 수 있으려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeConditionCombo" FontSize="11" HorizontalAlignment="Stretch" />

                        <CheckBox x:Name="EdgeHideCheck" Content="잠기면 숨김" FontSize="11"
                                  ToolTip.Tip="켜면 조건 미달일 때 선택지 자체가 안 보입니다. 끄면 잠긴 채 보이고 아래 안내문이 뜹니다." />
                        <TextBox x:Name="EdgeLockedMsgBox" FontSize="11"
                                 PlaceholderText="잠금 안내문 — 잠긴 채 보일 때 (예: 신뢰가 부족하다)" />

                        <!-- 스탯이 변하는 유일한 자리 (2026-08-14) — 이 간선을 타는 순간 1회 커밋. -->
                        <TextBlock Text="스탯변화 — 이 길을 고르면" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <TextBox x:Name="EdgeStatsBox" FontSize="11"
                                 PlaceholderText="예: trust +1; fatigue -1 (정수만, ;로 나열)"
                                 ToolTip.Tip="에피소드 사이를 건너는 순간 1회 반영됩니다. 스탯 시트에 있는 키만 쓸 수 있고, 도달성 증명이 이 값 그대로 전이합니다." />

                        <Button x:Name="EdgeApplyButton" Content="적용" HorizontalAlignment="Stretch" />
                        <Button x:Name="EdgeDeleteButton" Content="간선 삭제" HorizontalAlignment="Stretch" />
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 대사 미리보기 — 시나리오 그래프까지 안 가도 여기서 읽는다.
                     원천은 방금 읽은 에피소드 워크북이고, 고치는 곳은 엑셀이다. -->
                <TabItem x:Name="DialogueTab" Header="대사" FontSize="12">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <TextBlock x:Name="DialoguePreviewHeader"
                                   FontSize="10"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="False">
                            <SelectableTextBlock x:Name="DialoguePreviewText"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"
                                                 LineHeight="17" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <Expander x:Name="DiagnosticsExpander"
                      Header="검증 보고"
                      Padding="0"
                      HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <!-- 보고를 그대로 들고 나갈 수 있어야 한다 — 협업자·세션에 붙여넣는 용도. -->
                    <Button Grid.Row="0"
                            x:Name="CopyDiagnosticsButton"
                            Content="보고 복사"
                            FontSize="10"
                            Padding="8,2"
                            Margin="10,4,10,0"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="아래 목록 전체를 클립보드로 복사합니다. 줄 하나만 필요하면 드래그로 선택해도 됩니다." />
                    <!-- AllowAutoHide=False — 목록이 길 때 "아래 더 있다"가 보여야 한다.
                         숨는 오버레이 스크롤바는 동기화 보고가 묻혀 있다는 사실 자체를 숨겼다(실사례). -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel x:Name="DiagnosticsPanel" Margin="10,6" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
