<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.ChapterGraphView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="챕터"
                           FontSize="11"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" x:Name="ChapterCombo" MinWidth="180" />
                <Button Grid.Column="2" x:Name="ReloadButton" Content="다시 읽기" Margin="6,0,0,0" />
                <Button Grid.Column="3" x:Name="OpenFolderButton" Content="폴더 열기" Margin="6,0,0,0" />
                <!-- G8 — 검증을 통과해야만 나간다. 오류가 있으면 거부하고 사유를 보고 패널에 세운다. -->
                <Button Grid.Column="4"
                        x:Name="ExportButton"
                        Content="내보내기"
                        Margin="6,0,0,0"
                        ToolTip.Tip="런타임 수입용 JSON을 exported/ 폴더에 씁니다. 검증 오류가 있으면 거부됩니다." />
                <Button Grid.Column="5"
                        x:Name="AddEpisodeButton"
                        Content="＋ 에피소드"
                        Margin="6,0,0,0"
                        ToolTip.Tip="에피소드 행을 시트에 더합니다. Id·대사엔트리는 우측 패널에서 채우세요." />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            Spacing="6">
                    <TextBlock Text="픽스처"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center" />
                    <!-- 재생루트 하이라이트 (G6). 픽스처는 테스트 데이터라 내보내기에 섞이지 않는다. -->
                    <ComboBox x:Name="FixtureCombo" MinWidth="130" FontSize="11" />
                    <TextBlock x:Name="FixtureStopText"
                               FontSize="10"
                               Opacity="0.7"
                               Foreground="DarkGoldenrod"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- G-2 v2 — 엑셀이 원본이고 툴 편집은 해당 셀에 즉시 저장된다. -->
                <Border Grid.Column="8"
                        Padding="7,3"
                        CornerRadius="3"
                        Background="#22808080">
                    <TextBlock Text="엑셀이 원본 · 편집은 엑셀 셀에 저장됩니다"
                               FontSize="10"
                               Opacity="0.75" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,6,300">
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="GraphScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="GraphCanvas" Background="Transparent" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 속성 패널 (G-2 v2) — 소량 편집은 여기서, 대량(대사)은 엑셀에서.
                 모든 [적용]은 엑셀 셀에 써지고, 저장 감시가 다시 읽어 그래프가 따라온다. -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" Spacing="6">
                    <TextBlock x:Name="NoSelectionText"
                               Text="노드를 클릭하면 여기서 편집합니다.&#x0A;더블클릭 = 에피소드 엑셀 열기&#x0A;드래그 = 위치 이동(엑셀 X·Y에 저장)"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="PropertyPanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="에피소드" FontWeight="SemiBold" FontSize="12" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="IdBox" FontSize="11" PlaceholderText="EpisodeId" />
                            <Button Grid.Column="1" x:Name="RenameButton" Content="개명" FontSize="11"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="간선·픽스처 참조가 함께 따라갑니다. 조건식의 cleared: 참조가 있으면 거부됩니다." />
                        </Grid>

                        <TextBox x:Name="TitleBox" FontSize="11" PlaceholderText="제목" />

                        <Grid ColumnDefinitions="*,6,*">
                            <TextBox Grid.Column="0" x:Name="IndexBox" FontSize="11" PlaceholderText="인덱스" />
                            <ComboBox Grid.Column="2" x:Name="KindCombo" FontSize="11" />
                        </Grid>

                        <TextBox x:Name="EntryBox" FontSize="11" PlaceholderText="대사엔트리 (런타임이 재생할 이름)" />

                        <TextBlock Text="표시조건 / 해금조건" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <ComboBox x:Name="VisibleCombo" FontSize="11" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="UnlockCombo" FontSize="11" HorizontalAlignment="Stretch" />

                        <TextBox x:Name="EndingKeyBox" FontSize="11" PlaceholderText="엔딩키 (비면 엔딩 아님)" />
                        <TextBox x:Name="MemoBox" FontSize="11" PlaceholderText="메모" />
                        <CheckBox x:Name="AllowUnreachableCheck" Content="도달불가 허용" FontSize="11"
                                  ToolTip.Tip="의도적으로 닿을 수 없는 노드(폐기 예정·미완성)임을 표시합니다. 도달성 검증이 오류 대신 알림으로 낮춥니다." />

                        <Button x:Name="ApplyButton" Content="적용" HorizontalAlignment="Stretch" />

                        <TextBlock Text="다음 에피소드" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" />
                        <!-- 목록의 줄을 클릭하면 그 간선이 선택되어 조건·해금을 편집한다. -->
                        <StackPanel x:Name="EdgeListPanel" Spacing="3" />

                        <!-- 분기 저작의 핵심 — Id 하나로 새 에피소드가 만들어져 부모 오른쪽에 서고 간선이 이어진다. -->
                        <Grid ColumnDefinitions="*,6,*,Auto">
                            <TextBox Grid.Column="0" x:Name="NewNextIdBox" FontSize="11" PlaceholderText="새 분기 Id" />
                            <TextBox Grid.Column="2" x:Name="NewNextLabelBox" FontSize="11" PlaceholderText="선택지 라벨(선택)" />
                            <Button Grid.Column="3" x:Name="CreateNextButton" Content="＋ 분기" FontSize="11" Margin="4,0,0,0"
                                    ToolTip.Tip="새 에피소드를 만들어 이 노드의 다음으로 잇습니다. 부모 오른쪽에 순서대로 배치됩니다." />
                        </Grid>

                        <!-- 이미 있는 에피소드로 잇기 (합류·순환). -->
                        <Grid ColumnDefinitions="*,6,*,Auto">
                            <ComboBox Grid.Column="0" x:Name="EdgeTargetCombo" FontSize="11" />
                            <TextBox Grid.Column="2" x:Name="EdgeLabelBox" FontSize="11" PlaceholderText="선택지 라벨(선택)" />
                            <Button Grid.Column="3" x:Name="AddEdgeButton" Content="연결" FontSize="11" Margin="4,0,0,0"
                                    ToolTip.Tip="이미 있는 에피소드를 다음으로 잇습니다." />
                        </Grid>

                        <Button x:Name="DeleteEpisodeButton"
                                Content="에피소드 삭제"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                ToolTip.Tip="행과 그 간선·픽스처 참조를 함께 지웁니다. 에피소드 엑셀 파일은 지우지 않습니다." />
                    </StackPanel>

                    <!-- 간선 편집 — 그래프에서 간선을 클릭하면 여기가 열린다. 선택지형 VN의
                         "이 분기는 언제 보이고 언제 열리는가"를 여기서 정한다. -->
                    <StackPanel x:Name="EdgePanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="간선" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="EdgeFromToText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                        <TextBox x:Name="EdgeLabelEditBox" FontSize="11"
                                 PlaceholderText="선택지 라벨 (비면 분기 없는 일반 진행)" />

                        <TextBlock Text="조건 — 이 분기를 고를 수 있으려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeConditionCombo" FontSize="11" HorizontalAlignment="Stretch" />

                        <CheckBox x:Name="EdgeHideCheck" Content="잠기면 숨김" FontSize="11"
                                  ToolTip.Tip="켜면 조건 미달일 때 선택지 자체가 안 보입니다. 끄면 잠긴 채 보이고 아래 안내문이 뜹니다." />
                        <TextBox x:Name="EdgeLockedMsgBox" FontSize="11"
                                 PlaceholderText="잠금 안내문 — 잠긴 채 보일 때 (예: 신뢰가 부족하다)" />

                        <Button x:Name="EdgeApplyButton" Content="적용" HorizontalAlignment="Stretch" />
                        <Button x:Name="EdgeDeleteButton" Content="간선 삭제" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- 조건 시트 편집 — 라벨이 이미 있으면 수정, 없으면 추가. 식의 내용은 검증기가 잡는다. -->
                    <StackPanel x:Name="ConditionSection" Spacing="4" Margin="0,14,0,0">
                        <TextBlock Text="조건 (라벨 ↔ 식)" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="ConditionListPanel" Spacing="2" />
                        <TextBox x:Name="ConditionLabelBox" FontSize="11" PlaceholderText="라벨" />
                        <TextBox x:Name="ConditionExprBox" FontSize="11" PlaceholderText="식 — 예: trust >= 3 (AND는 ;)" />
                        <Button x:Name="SaveConditionButton" Content="조건 추가/수정" HorizontalAlignment="Stretch" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <Expander x:Name="DiagnosticsExpander"
                      Header="검증 보고"
                      Padding="0"
                      HorizontalAlignment="Stretch">
                <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiagnosticsPanel" Margin="10,6" Spacing="2" />
                </ScrollViewer>
            </Expander>
        </Border>
    </Grid>
</UserControl>
