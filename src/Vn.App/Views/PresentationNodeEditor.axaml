<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.PresentationNodeEditor">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="연출 노드" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" PlaceholderText="노드 이름" />

            <!-- 입력 결과·공급 대상 콤보와 [연출 발행]은 2026-08-21에 사라졌다 —
                 채널이 자동으로 최신 대사 발행본을 고정하고 공급·발행까지 한다
                 (ProjectEditor.EnsurePresentationChannel). 상태는 아래 한 줄이 말한다. -->
            <TextBlock x:Name="ChannelStatusText" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />

            <TextBlock x:Name="TargetText" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,10,0,8"
                Padding="8"
                CornerRadius="6"
                Background="#12000000">
            <TextBlock Text="대사는 발행된 결과에서 온 읽기 전용 스냅샷입니다. 여기서 고쳐도 원고는 바뀌지 않습니다. 체크박스는 작성 데이터를 지우지 않고 명령의 활성 상태만 바꿉니다."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.7" />
        </Border>

        <Panel Grid.Row="2" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LineHost" Spacing="8" />
        </ScrollViewer>
    </Grid>
</UserControl>
