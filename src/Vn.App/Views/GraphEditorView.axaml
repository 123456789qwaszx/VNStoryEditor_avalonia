<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.GraphEditorView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- [+ 설정 노드]는 폐지됐다 (2026-08-17 소유자) — 설정노드는 챕터마다
                     하나가 자동으로 서는 컨트롤러라, 만들고 지우는 것이 아니다. -->
                <!-- [+ 연출 노드]도 폐지됐다 (2026-08-21 소유자) — 연출 채널은 무대
                     프리뷰에서 고르면 자동으로 선다(EnsurePresentationChannel).
                     [+ 연출 공급]도 같은 날 폐지됐다 — 공급 노드가 잇던 상대(연출 노드)가
                     배관으로 숨어 이 판에서 할 일이 없다. 남는 필터는 대사·설정 둘이다.
                     [흐름만]도 2026-08-22에 폐지됐다 (소유자) — 체크 둘을 대신 눌러 주는
                     단축일 뿐이라, 남은 토글이 둘뿐인 지금은 손이 더 가는 길이었다. -->
                <!--
                  챕터 고르기 (2026-08-25 소유자) — 챕터 그래프의 그 드롭다운을 여기서도
                  든다. 새 노드는 <b>지금 활성인 판</b>에 서는데, 그 판이 무엇인지 이 화면에
                  보이지 않아 "어느 챕터에 만들어졌는지" 알 수 없었다. 여기서 고르면 그 판이
                  활성이 되고, 그 뒤의 [+ 대사 노드]가 거기에 선다.
                -->
                <TextBlock Text="챕터" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ComboBox x:Name="ChapterCombo" MinWidth="140" FontSize="11"
                          ToolTip.Tip="새 노드가 설 판입니다. 챕터 그래프의 선택과 같은 값을 봅니다." />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <Button x:Name="AddDialogueButton" Content="+ 대사 노드" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <Button x:Name="DeleteNodeButton" Content="노드 삭제" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <TextBlock Text="필터" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                <CheckBox x:Name="FilterDialogueCheck" Content="대사" FontSize="11" IsChecked="True" />
                <CheckBox x:Name="FilterSetCheck" Content="설정" FontSize="11" IsChecked="True" />
            </StackPanel>
        </Border>

        <!-- 우측 곁기둥(노드 편집기 + 에셋 탐색기)이 2026-08-22에 이 판 안으로 들어왔다
             (소유자) — 예전에는 창이 들고 있어 탭마다 접었다 폈다 했다. 쓰는 화면이
             여기뿐이므로 여기 산다: 챕터 그래프에도 무대 프리뷰에도 안 보인다.
             ⚠ 자리만 이 뷰가 내주고 <b>내용은 셸이 짓는다</b>(SetSidePanel) — 편집기들의
             배선이 세션·프리뷰·발행과 얽혀 있어 뷰로 옮기면 그 배선이 두 벌이 된다. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,460">
            <ScrollViewer x:Name="GraphScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <!-- 배율은 레이아웃 변환이다 — 스크롤 범위가 확대/축소를 그대로 따라온다 (W40). -->
                <!-- 크기는 코드비하인드의 CanvasWidth/Height가 정한다 (W41) — 미니맵 배율과
                     한 곳에서 맞아야 하므로 여기에 숫자를 적지 않는다. -->
                <!-- 배경은 반드시 실제 브러시여야 한다: FluentTheme에는 ThemeBackgroundBrush가
                     없어 null이 되고, 배경 없는 Canvas는 빈 곳 클릭이 히트되지 않아
                     범위 선택·간선 선택 해제가 조용히 죽는다. Transparent도 히트는 된다. -->
                <LayoutTransformControl x:Name="ZoomHost">
                    <Canvas x:Name="GraphCanvas"
                            Background="Transparent" />
                </LayoutTransformControl>
            </ScrollViewer>

            <!-- 미니맵 (W40) — 우측 하단에 전체 맵과 현재 배율. 클릭·드래그로 뷰포트 이동. -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,18"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#66808080"
                    Background="#F2F6F7FA">
                <StackPanel>
                    <Canvas x:Name="MinimapCanvas"
                            Width="180"
                            Height="120"
                            ClipToBounds="True"
                            Background="Transparent"
                            Cursor="Hand" />
                    <!-- 전체 보기·배율 프리셋 (GB-4) — 큰 판의 길찾기. -->
                    <Border BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="4,2">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                            <Button Grid.Column="0" x:Name="FitAllButton" Content="전체"
                                    FontSize="9" Padding="5,1" Margin="0,0,3,0" />
                            <Button Grid.Column="1" x:Name="Zoom50Button" Content="50"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="2" x:Name="Zoom100Button" Content="100"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="3" x:Name="Zoom150Button" Content="150"
                                    FontSize="9" Padding="4,1" />
                            <TextBlock Grid.Column="4"
                                       x:Name="ZoomText"
                                       FontSize="10"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="100%" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1,0,0,0">
                <ContentControl x:Name="SideHost" />
            </Border>
        </Grid>

        <!-- 아래 띠는 <b>지금 무슨 일이 벌어지는지</b>만 말한다 (2026-08-24 소유자:
             "포트를 끌어 놓으면 연결, 빈곳좌클릭 드래그 범위선택 이런 설명문구도 제거").
             늘 서 있던 조작법 설명은 사라졌다 — 손이 이미 아는 것을 화면이 매번 다시
             일러 주면 정작 무언가를 말해야 할 때 눈에 안 띈다.

             남은 것은 둘: 포트를 끄는 중의 안내(어디에 놓으면 되는가·빈 곳은 끊기)와
             고른 간선의 정체다. 할 말이 없으면 띠 자체가 접힌다 — 빈 칸이 서 있으면
             그것도 소음이다. 여닫는 문은 SetHint 하나다. -->
        <Border Grid.Row="2"
                x:Name="HintBar"
                Padding="10,6"
                IsVisible="False"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
