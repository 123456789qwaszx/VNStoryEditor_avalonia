<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.GraphEditorView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- [+ 설정 노드]는 폐지됐다 (2026-08-17 소유자) — 설정노드는 챕터마다
                     하나가 자동으로 서는 컨트롤러라, 만들고 지우는 것이 아니다. -->
                <Button x:Name="AddDialogueButton" Content="+ 대사 노드" />
                <Button x:Name="AddPresentationButton" Content="+ 연출 노드" />
                <Button x:Name="AddSupplyButton" Content="+ 연출 공급" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <Button x:Name="DeleteNodeButton" Content="노드 삭제" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <TextBlock Text="필터" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                <CheckBox x:Name="FilterDialogueCheck" Content="대사" FontSize="11" IsChecked="True" />
                <CheckBox x:Name="FilterSetCheck" Content="설정" FontSize="11" IsChecked="True" />
                <CheckBox x:Name="FilterPresentationCheck" Content="연출" FontSize="11" IsChecked="True" />
                <CheckBox x:Name="FilterSupplyCheck" Content="공급" FontSize="11" IsChecked="True" />
                <CheckBox x:Name="FilterResultCheck" Content="결과" FontSize="11" IsChecked="True" />
                <Button x:Name="FlowOnlyButton" Content="흐름만" FontSize="11" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="GraphScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <!-- 배율은 레이아웃 변환이다 — 스크롤 범위가 확대/축소를 그대로 따라온다 (W40). -->
                <!-- 크기는 코드비하인드의 CanvasWidth/Height가 정한다 (W41) — 미니맵 배율과
                     한 곳에서 맞아야 하므로 여기에 숫자를 적지 않는다. -->
                <!-- 배경은 반드시 실제 브러시여야 한다: FluentTheme에는 ThemeBackgroundBrush가
                     없어 null이 되고, 배경 없는 Canvas는 빈 곳 클릭이 히트되지 않아
                     범위 선택·간선 선택 해제가 조용히 죽는다. Transparent도 히트는 된다. -->
                <LayoutTransformControl x:Name="ZoomHost">
                    <Canvas x:Name="GraphCanvas"
                            Background="Transparent" />
                </LayoutTransformControl>
            </ScrollViewer>

            <!-- 미니맵 (W40) — 우측 하단에 전체 맵과 현재 배율. 클릭·드래그로 뷰포트 이동. -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,18"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#66808080"
                    Background="#F2F6F7FA">
                <StackPanel>
                    <Canvas x:Name="MinimapCanvas"
                            Width="180"
                            Height="120"
                            ClipToBounds="True"
                            Background="Transparent"
                            Cursor="Hand" />
                    <!-- 전체 보기·배율 프리셋 (GB-4) — 큰 판의 길찾기. -->
                    <Border BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="4,2">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                            <Button Grid.Column="0" x:Name="FitAllButton" Content="전체"
                                    FontSize="9" Padding="5,1" Margin="0,0,3,0" />
                            <Button Grid.Column="1" x:Name="Zoom50Button" Content="50"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="2" x:Name="Zoom100Button" Content="100"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="3" x:Name="Zoom150Button" Content="150"
                                    FontSize="9" Padding="4,1" />
                            <TextBlock Grid.Column="4"
                                       x:Name="ZoomText"
                                       FontSize="10"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="100%" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,6"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="포트(●)를 끌어 노드에 놓으면 연결 · 빈 곳 좌클릭 드래그=범위 선택 · 중간 버튼=이동 · Ctrl+휠=확대/축소" />
        </Border>
    </Grid>
</UserControl>
