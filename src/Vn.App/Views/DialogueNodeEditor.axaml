<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />

                <!-- 대본은 노드와 함께 태어난다 (X4) — 선택·가져오기 진입점 없음. -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="ScriptSummaryTitleText"
                               Text="대본"
                               FontSize="11"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="AddLineButton"
                            Margin="6,0,0,0"
                            Content="줄 추가"
                            FontSize="11" />
                </Grid>

                <TextBlock x:Name="ScriptSummaryText"
                           FontSize="11"
                           Opacity="0.65"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="EditorTabs">
            <TabItem Header="대사 편집">
                <Grid RowDefinitions="*,Auto">
                    <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다 (W49). -->
                    <ScrollViewer Grid.Row="0"
                                  x:Name="LineScroll"
                                  Background="Transparent"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Padding="12,10"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="기본 출구" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="DefaultExitSubtitle"
                                       Text="모든 줄과 조건 갈래가 끝난 뒤 이동합니다."
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                            <!-- 커스텀 노드에는 출구가 없다 (2026-08-21) — 이 줄은 엑셀노드에서만 보인다. -->
                            <Grid x:Name="DefaultExitControls" ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0"
                                          x:Name="DefaultExitCheck"
                                          Content="다음 노드로 이동"
                                          VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          x:Name="DefaultExitCombo"
                                          Margin="10,0,0,0"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="대상 노드" />
                            </Grid>
                            <!-- 출구가 꺼져 있을 때 무슨 일이 일어나는지 — 침묵이 의문을 만들었다. -->
                            <TextBlock x:Name="ExitHintText"
                                       FontSize="10"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="발행">
                <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="발행 결과 (연출 바인딩용 스냅샷)" FontWeight="SemiBold" />
                        <TextBlock Text="발행은 내보내기 게이트가 아닙니다. 연출노드가 읽을 읽기전용 스냅샷(LineId·화자·대사·선택지·조건)을 얼릴 뿐이며, 출력은 편집 즉시 현재 상태로 합성됩니다."
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PublishButton" Content="이 상태를 발행" />
                            <TextBlock x:Name="PublishStatusText"
                                       FontSize="11"
                                       Opacity="0.75"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportNodeButton" Content="이 노드 내보내기…" FontSize="11" />
                            <Button x:Name="ExportNodeCsvButton" Content="이 노드 CSV…" FontSize="11" />
                            <TextBlock x:Name="ExportPairText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ResultHost" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Script Preview">
                <Grid RowDefinitions="Auto,*,Auto" Margin="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,220"
                          Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="평면 문서 Preview" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewSummaryText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                            <TextBlock Text="출력 프리셋" FontSize="10" Opacity="0.6" />
                            <ComboBox x:Name="PreviewPresetCombo"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1"
                             x:Name="PreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" />

                    <!-- ScenarioOnly만 편집면이다 (X12a). 나머지 양식은 읽기 전용 라이브 미러. -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyScenarioButton"
                                    Content="텍스트 반영"
                                    FontSize="11"
                                    IsVisible="False" />
                            <TextBlock x:Name="ScenarioApplyHintText"
                                       FontSize="10"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="ScenarioProblemsText"
                                   FontSize="10"
                                   Foreground="#C2410C"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
