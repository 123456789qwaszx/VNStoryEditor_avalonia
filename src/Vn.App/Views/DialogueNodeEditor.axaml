<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />

                <!-- 대본은 노드와 함께 태어난다 (X4) — 선택·가져오기 진입점 없음.
                     줄 수·로케일은 2026-08-22에 <b>이름 오른쪽</b>으로 올라왔다 (소유자) —
                     제 줄을 차지할 만큼의 정보가 아니고, 머리글과 떨어져 있으면 무엇에 대한
                     숫자인지 한 박자 늦게 읽힌다. -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="ScriptSummaryTitleText"
                               Text="대본"
                               FontSize="11"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ScriptSummaryText"
                               Margin="8,0,6,0"
                               FontSize="11"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            x:Name="AddLineButton"
                            Content="줄 추가"
                            FontSize="11" />
                </Grid>

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="EditorTabs">
            <TabItem Header="대사 편집">
                <!-- ⚠ [기본 출구] 편집 구역은 2026-08-22에 사라졌다 (소유자: "연출그래프에서
                     만질 일이 없을 테니 그냥 없애도 될 것 같아") — 같은 값을 판의 레일
                     칩(`○ 진행`)이 이미 편집한다. 한 값에 편집 창구가 둘이면 어느 쪽이
                     최신인지 화면이 대답하지 못한다. 데이터·포트·출력은 그대로다. -->
                <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다 (W49). -->
                <ScrollViewer x:Name="LineScroll"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="발행">
                <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="발행 결과 (연출 바인딩용 스냅샷)" FontWeight="SemiBold" />
                        <!-- [이 상태를 발행]은 2026-08-21에 사라졌다 — 무대 프리뷰에서 씬을
                             고르면 채널이 자동으로 발행·고정한다(EnsurePresentationChannel). -->
                        <TextBlock Text="발행은 자동입니다. 무대 프리뷰에서 이 씬을 고르면 현재 상태가 스냅샷(LineId·화자·대사·선택지·조건)으로 얼어 연출이 그 위에 붙습니다. 출력은 편집 즉시 현재 상태로 합성됩니다."
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PublishStatusText"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportNodeButton" Content="이 노드 내보내기…" FontSize="11" />
                            <Button x:Name="ExportNodeCsvButton" Content="이 노드 CSV…" FontSize="11" />
                            <TextBlock x:Name="ExportPairText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ResultHost" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Script Preview">
                <Grid RowDefinitions="Auto,*,Auto" Margin="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,220"
                          Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="평면 문서 Preview" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewSummaryText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                            <TextBlock Text="출력 프리셋" FontSize="10" Opacity="0.6" />
                            <ComboBox x:Name="PreviewPresetCombo"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1"
                             x:Name="PreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" />

                    <!-- ScenarioOnly만 편집면이다 (X12a). 나머지 양식은 읽기 전용 라이브 미러. -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyScenarioButton"
                                    Content="텍스트 반영"
                                    FontSize="11"
                                    IsVisible="False" />
                            <TextBlock x:Name="ScenarioApplyHintText"
                                       FontSize="10"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="ScenarioProblemsText"
                                   FontSize="10"
                                   Foreground="#C2410C"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
