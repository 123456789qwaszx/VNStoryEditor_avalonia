<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />

                <!-- 대본은 노드와 함께 태어난다 (X4) — 선택·가져오기 진입점 없음.
                     줄 수·로케일은 2026-08-22에 <b>이름 오른쪽</b>으로 올라왔다 (소유자) —
                     제 줄을 차지할 만큼의 정보가 아니고, 머리글과 떨어져 있으면 무엇에 대한
                     숫자인지 한 박자 늦게 읽힌다. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="ScriptSummaryTitleText"
                               Text="대본"
                               FontSize="11"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ScriptSummaryText"
                               Margin="8,0,6,0"
                               FontSize="11"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- ⛔ 대사 잠금 토글([🔒 대사 잠김])은 2026-09-16에 사라졌다 (R-E ·
                         지시서 §6.4). 그것이 지키던 것은 "여기서 고쳐도 다음 동기화가
                         되돌린다"였는데, 그 동기화가 R-D에서 철거됐다 — 이제 <b>모든 노드의
                         대본은 툴 소유</b>이고 잠글 원본이 없다. 열의 자리는 남는다
                         (Grid.Column 3 = [줄 추가]). -->
                    <Button Grid.Column="3"
                            x:Name="AddLineButton"
                            Content="줄 추가"
                            FontSize="11" />
                </Grid>

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="EditorTabs">
            <TabItem Header="대사 편집">
                <!-- ⚠ [기본 출구] 편집 구역은 2026-08-22에 사라졌다 (소유자: "연출그래프에서
                     만질 일이 없을 테니 그냥 없애도 될 것 같아") — 같은 값을 판의 레일
                     칩(`○ 진행`)이 이미 편집한다. 한 값에 편집 창구가 둘이면 어느 쪽이
                     최신인지 화면이 대답하지 못한다. 데이터·포트·출력은 그대로다. -->
                <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다 (W49). -->
                <ScrollViewer x:Name="LineScroll"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
                </ScrollViewer>
            </TabItem>

            <!-- ⛔ [발행] 탭은 2026-09-15에 사라졌다 (소유자: "저거 솔직히 필요없어 보이는데").
                 셋이 함께 걷혔다 — ① 발행 상태 문구(PublishStatusText) ② 발행 이력 목록
                 (ResultHost) ③ 노드 단위 내보내기 단추 둘. ①②는 [이 상태를 발행]이
                 2026-08-21에 자동이 된 뒤로 읽기 전용 현황판이었고, 현황판은 볼 이유가
                 사라지면 지운다는 것이 이 판의 선례다([편집 자료] 현황판, 2026-08-21).
                 ③은 툴바 [내보내기…]·[CSV 내보내기…]가 같은 PickNodeExportsAsync로 노드를
                 골라 내보내므로 창구가 둘이던 것이다. ⚠ 발행 자체는 그대로다 — 자동 발행
                 (ProjectEditor.EnsurePresentationChannel)·Results 층·출력은 손대지 않았다.
                 되살리려면 이 탭과 BuildResults/RefreshExportState/ExportNodeAsync를 함께
                 되돌려야 한다(컨트롤만 세우면 갱신이 안 붙는다). -->

            <TabItem Header="Script Preview">
                <Grid RowDefinitions="Auto,*,Auto" Margin="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,220"
                          Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="평면 문서 Preview" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewSummaryText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                            <TextBlock Text="출력 프리셋" FontSize="10" Opacity="0.6" />
                            <ComboBox x:Name="PreviewPresetCombo"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1"
                             x:Name="PreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" />

                    <!-- ScenarioOnly만 편집면이다 (X12a). 나머지 양식은 읽기 전용 라이브 미러. -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyScenarioButton"
                                    Content="텍스트 반영"
                                    FontSize="11"
                                    IsVisible="False" />
                            <TextBlock x:Name="ScenarioApplyHintText"
                                       FontSize="10"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="ScenarioProblemsText"
                                   FontSize="10"
                                   Foreground="#C2410C"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
