<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.AnalysisView">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ProjectPathBox"
                     Width="640"
                     PlaceholderText="Demo.yarnproject 경로" />
        </StackPanel>

        <TextBox x:Name="OutputBox"
                 Margin="0,12,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" />
    </DockPanel>
</UserControl>