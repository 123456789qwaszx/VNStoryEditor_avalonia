<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.AnalysisView">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ProjectPathBox"
                     Width="640"
                     PlaceholderText="Demo.yarnproject 경로" />
            <Button x:Name="AnalyzeButton"
                    Content="분석"
                    Click="OnAnalyzeClick" />
        </StackPanel>

        <!-- 요약 한 줄과 오류 메시지가 여기로 온다. 목록은 결과만 담는다. -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <!-- 파일 전체를 띄워야 하므로 편집기에 세로 공간을 통째로 준다.
             목록 아래에 쌓으면 파일이 몇 줄만 보이는 창이 된다. -->
        <Grid ColumnDefinitions="*,8,1.2*" Margin="0,12,0,0">
            <Grid Grid.Column="0" RowDefinitions="*,*,2*">
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="소스 파일"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <ListBox x:Name="SourceFileList" FontFamily="Consolas" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="노드"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <ListBox x:Name="NodeList"
                             FontFamily="Consolas"
                             SelectionChanged="OnNodeSelected" />
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="진단"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <ListBox x:Name="DiagnosticList" FontFamily="Consolas" />
                </DockPanel>
            </Grid>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="파일"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="FileBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
