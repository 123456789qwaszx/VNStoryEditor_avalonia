<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.AnalysisView"
             KeyDown="OnKeyDown">
    <UserControl.DataTemplates>
        <DataTemplate DataType="views:NodeListItem" x:DataType="views:NodeListItem">
            <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.6" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="views:SourceFileListItem" x:DataType="views:SourceFileListItem">
            <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding RelativePath}" FontSize="11" Opacity="0.6" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="views:DiagnosticListItem" x:DataType="views:DiagnosticListItem">
            <Grid Margin="4,6" ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        Padding="5,2"
                        CornerRadius="4"
                        Background="{Binding BadgeBrush}">
                    <TextBlock Text="{Binding SeverityText}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.65" />
                        <TextBlock Text="{Binding Code}" FontSize="11" Opacity="0.45" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Margin="12" ColumnDefinitions="300,8,*">
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <Grid RowDefinitions="Auto,*">
                <TextBox Grid.Row="0"
                         x:Name="SearchBox"
                         PlaceholderText="장면 이름 검색"
                         TextChanged="OnSearchTextChanged" />

                <TabControl Grid.Row="1" Margin="0,8,0,0">
                    <TabItem Header="장면">
                        <ListBox x:Name="NodeList"
                                 SelectionChanged="OnNodeSelected" />
                    </TabItem>
                    <TabItem Header="파일">
                        <ListBox x:Name="SourceFileList"
                                 SelectionChanged="OnSourceFileSelected" />
                    </TabItem>
                    <TabItem Header="문제">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock x:Name="DiagnosticSummaryText"
                                       Grid.Row="0"
                                       Margin="6"
                                       Opacity="0.7" />
                            <ListBox x:Name="DiagnosticList"
                                     Grid.Row="1"
                                     SelectionChanged="OnDiagnosticSelected" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="{DynamicResource ThemeBorderLowBrush}" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="10,8"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6,6,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DocumentTitleText"
                                   Text="열린 문서 없음"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectionText"
                                   FontSize="11"
                                   Opacity="0.65" />
                    </StackPanel>
                    <TextBlock x:Name="DocumentStateText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        x:Name="EditorTabs"
                        SelectionChanged="OnEditorTabChanged">
                <TabItem Header="구조로 보기">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                x:Name="StructureNoticeBorder"
                                Padding="10,7"
                                Background="{DynamicResource ThemeControlMidBrush}"
                                IsVisible="False">
                            <TextBlock x:Name="StructureNoticeText"
                                       TextWrapping="Wrap" />
                        </Border>
                        <views:BoxListView Grid.Row="1" x:Name="BoxList" />
                    </Grid>
                </TabItem>
                <TabItem Header="Yarn 원문">
                    <TextBox x:Name="FileBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas"
                             FontSize="14"
                             Padding="12"
                             TextChanged="OnFileTextChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
