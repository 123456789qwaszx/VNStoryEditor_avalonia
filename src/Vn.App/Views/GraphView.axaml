<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.GraphView">
    <Grid ColumnDefinitions="*,280">
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="GraphCanvas"
                    Width="2000"
                    Height="1200"
                    Background="{DynamicResource ThemeBackgroundBrush}" />
        </ScrollViewer>

        <Border Grid.Column="1"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="선택한 장면" FontWeight="SemiBold" />
                <TextBlock x:Name="SelectedTitleText"
                           Text="장면을 선택해 주세요"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SelectedBodyText"
                           TextWrapping="Wrap"
                           Opacity="0.7" />
                <TextBlock Margin="0,16,0,0"
                           Text="장면을 클릭하면 대본 작업 화면으로 이동합니다. 노드를 끌어 놓으면 이 프로젝트의 그래프 배치가 기억됩니다."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
