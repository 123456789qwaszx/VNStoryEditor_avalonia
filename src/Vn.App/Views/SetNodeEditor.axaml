<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.SetNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="설정 이름" />
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="14">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="조건" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddConditionButton" Content="조건 추가" FontSize="11" />
                    </Grid>
                    <TextBlock Text="여기서 만든 조건이 대사 노드의 조건 드롭다운에 나타납니다. 식은 게임이 해석합니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ConditionHost" Spacing="6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="변수 값" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddAssignmentButton" Content="변수 추가" FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="VariableHintText"
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="AssignmentHost" Spacing="6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="화자" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddSpeakerButton" Content="화자 추가" FontSize="11" />
                    </Grid>
                    <!-- 2026-08-17 소유자 — 두 계층을 가른다. 기획자가 정한 화자는 회색
                         고정값으로 모든 조건노드에 서고, 작가가 더한 화자만 여기서 고친다.
                         작가의 것은 game.definition.json이 아니라 프로젝트에 저장된다. -->
                    <TextBlock Text="회색 줄은 기획자가 정한 화자입니다 — 여기서 고치지 않습니다(표정은 자유롭게 더할 수 있습니다). 아래 [화자 추가]로 만든 것은 작가의 것이고 프로젝트에 저장됩니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="SpeakerHost" Spacing="6" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
