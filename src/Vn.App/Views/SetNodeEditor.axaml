<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.SetNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="설정 이름" />
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="14">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="조건" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddConditionButton" Content="조건 추가" FontSize="11" />
                    </Grid>
                    <!-- 2026-08-17 소유자 — 식을 손으로 쓰지 않는다. 아이템·능력을 고르고
                         부호를 고르고 수치를 적는다(대사 노드의 Set과 같은 감각). -->
                    <TextBlock Text="아래 아이템·능력을 먼저 만들면 여기서 고를 수 있습니다. 여기서 만든 조건이 대사 노드의 조건 드롭다운에 나타납니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ConditionHost" Spacing="6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- 2026-08-17 소유자 — 작가가 쓰는 건 "변수"가 아니라 아이템·능력이다.
                             아이템은 개수로 늘고 줄고, 능력은 있다/없다뿐이다. -->
                        <TextBlock Grid.Column="0" Text="아이템 · 능력" FontWeight="SemiBold" />
                        <Button Grid.Column="1" x:Name="AddAssignmentButton" Content="＋ 추가" FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="VariableHintText"
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="AssignmentHost" Spacing="6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="화자" FontWeight="SemiBold" />
                    <!-- ⚠ [화자 추가]와 "작가가 더한 화자"는 2026-08-23에 폐지됐다
                         (소유자: "이런 캐릭터는 컨셉과 배경이라던지 그런 게 꼼꼼히
                         정해져야 하는데, 작가가 임의로 추가한다는 게 그렇게 좋아보이진
                         않아서"). 화자의 주인은 기획자 하나다 — 여기는 읽는 자리다. -->
                    <TextBlock Text="화자는 챕터 엑셀 `화자` 시트와 game.definition.json이 주인입니다 — 여기서는 고치지 않습니다. 표정은 에셋 폴더 규약이 주인이라 누구든 더할 수 있습니다."
                               FontSize="11"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="SpeakerHost" Spacing="6" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
