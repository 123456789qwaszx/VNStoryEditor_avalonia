<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.ChapterDataView">
    <!-- 챕터 그래프 화면일 때의 우측 패널 — 대사 편집기·무대 프리뷰 대신, 챕터 엑셀의
         내용(에피소드·간선·조건·스탯·픽스처)을 읽기 전용으로 보인다. 엑셀을 열지 않고도
         "지금 값이 뭐지"를 확인하는 자리이고, 고치는 곳은 엑셀 또는 챕터 그래프 패널이다. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
        <StackPanel x:Name="Sections" Margin="12,10" Spacing="4" />
    </ScrollViewer>
</UserControl>
