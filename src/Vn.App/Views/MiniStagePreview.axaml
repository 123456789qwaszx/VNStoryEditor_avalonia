<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <!-- 무대 프리뷰 판 (2026-08-20 중앙 탭 승격) — 좌: 대본 터미널, 우: 무대.
         예전의 "창으로 열기"·"접기"는 탭이 대체했다. -->
    <Border Padding="10,8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="무대 프리뷰"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           x:Name="ContextText"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- 재생 컨트롤 (W31) — 편집기 선택과 같은 StagePlayback 하나를 본다. -->
                <ContentControl Grid.Column="2"
                                x:Name="PlaybackHost" />
            </Grid>

            <!-- 뱃지·갈래 칩 — 많아지면 줄바꿈한다 (W37). 간격은 StageIndicators가 마진으로 준다. -->
            <WrapPanel Grid.Row="1"
                       x:Name="BadgeRow"
                       Margin="0,6,0,0" />

            <!-- 좌: 연출 대본 텍스트 패널(로그 터미널 감각) · 우: 무대.
                 무대 그리기는 StageSceneView 하나다(렌더 사본 금지). -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="360,6,*"
                  Margin="0,6,0,0">
                <ContentControl Grid.Column="0"
                                x:Name="ScriptHost" />
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />
                <ContentControl Grid.Column="2"
                                x:Name="SceneHost" />
            </Grid>

            <StackPanel Grid.Row="3" Spacing="4" Margin="0,6,0,0">
                <StackPanel x:Name="NoticeHost" Spacing="2" />
                <StackPanel x:Name="UnhandledHost" Spacing="2" IsVisible="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
