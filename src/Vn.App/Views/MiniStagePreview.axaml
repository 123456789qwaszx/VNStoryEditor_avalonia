<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- 에셋 루트 지정·새로 고침은 좌측 에셋 탐색기가 맡는다 (X8). -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="무대 프리뷰"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           x:Name="ContextText"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        x:Name="OpenWindowButton"
                        Content="창으로 열기"
                        FontSize="10"
                        Padding="6,2" />
            </Grid>

            <StackPanel Grid.Row="1"
                        x:Name="BadgeRow"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,6,0,0" />

            <!-- 축소판 무대 — 분리 창과 같은 StageSceneView를 쓴다(렌더 사본 금지). -->
            <ContentControl Grid.Row="2"
                            x:Name="SceneHost"
                            Height="185"
                            Margin="0,6,0,0" />

            <StackPanel Grid.Row="3" Spacing="4" Margin="0,6,0,0">
                <StackPanel x:Name="NoticeHost" Spacing="2" />
                <StackPanel x:Name="UnhandledHost" Spacing="2" IsVisible="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
