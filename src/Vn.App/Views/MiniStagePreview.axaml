<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <!-- 무대 프리뷰 판 (2026-08-20 중앙 탭 승격) — 좌: 대본 터미널, 우: 무대.
         예전의 "창으로 열기"·"접기"는 탭이 대체했다. -->
    <Border Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="무대 프리뷰"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           x:Name="ContextText"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 뱃지·갈래 칩 — 많아지면 줄바꿈한다 (W37). 간격은 StageIndicators가 마진으로 준다.
                 높이는 고정이고 넘치면 이 안에서 스크롤한다 (2026-08-21 소유자: 라인마다
                 개수가 달라 아래 전체가 밀리던 것 — "레이아웃을 건드리진 않게"). -->
            <ScrollViewer Grid.Row="1"
                          Height="28"
                          Margin="0,6,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="BadgeRow" />
            </ScrollViewer>

            <!-- 좌: 연출 대본 텍스트 패널(위) + 선택 대상 작업대(아래) · 우: 무대.
                 무대 그리기는 StageSceneView 하나다(렌더 사본 금지).
                 터미널:작업대 영역비는 가로 스플리터 드래그로 조절한다 (2026-08-21 소유자:
                 "높이에 따라 범위가 자꾸 변하는데 조작감이 너무 별로" — 고정 높이 + 내부 스크롤).
                 작업대는 <b>비어 있어도 접지 않는다</b>(같은 날: 클릭마다 레이아웃이 움직이던
                 원인) — 사람이 스플리터로 정한 비율만이 이 높이를 바꾼다. -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="380,10,*,6,340"
                  Margin="0,8,0,0">
                <Grid Grid.Column="0"
                      x:Name="LeftColumn"
                      RowDefinitions="Auto,*,8,260">
                    <!-- 씬 선택기 (2026-08-21 소유자) — "미리 다 해둔 다음에 무대
                         프리뷰측에서 뭘 할지 고르도록". 에피소드(📄)·커스텀 씬(✎)을
                         고르면 연출 채널이 자동으로 서고(발행·연결 전부) 터미널이 채워진다. -->
                    <ComboBox Grid.Row="0"
                              x:Name="SceneCombo"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="연출할 씬 선택 — 에피소드·커스텀 씬" />
                    <ContentControl Grid.Row="1"
                                    x:Name="ScriptHost" />
                    <GridSplitter Grid.Row="2"
                                  x:Name="DetailSplitter"
                                  ResizeDirection="Rows"
                                  Background="{DynamicResource ThemeBorderLowBrush}" />
                    <ScrollViewer Grid.Row="3"
                                  x:Name="DetailScroll"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="DetailHost"
                                        Margin="2,4,10,4" />
                    </ScrollViewer>
                </Grid>
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />
                <!-- 무대 + 아래 재생 줄 (2026-08-21 소유자: "재생이 프리뷰 아래쪽에 오는게
                     더 좋아보여. 타임라인이랑 같이") — 재생 컨트롤(W31)과 프레임 타임라인이
                     무대 바로 밑에 나란히 선다. -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <ContentControl Grid.Row="0"
                                    x:Name="SceneHost" />
                    <!-- 재생 줄 높이도 고정 — 타임라인이 있는 라인과 없는 라인 사이에서
                         무대 크기가 바뀌지 않는다.

                         자리로 무게를 가른다 (2026-08-21 소유자: "타임라인 가장 오른쪽으로
                         보내서 위치상 안 겹치게"): 왼쪽은 지금 다듬는 라인의 것([▶ 라인]·
                         진행), 오른쪽 끝은 가끔 쓰는 것(노드 전체 재생·배속). 타임라인이
                         가운데를 채우며 둘을 벌려 놓는다. -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,16,*,10,Auto,14,Auto"
                          Height="34"
                          Margin="0,8,0,0">
                        <ContentControl Grid.Column="0"
                                        x:Name="PlaybackHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="2"
                                        x:Name="TimelineHost"
                                        VerticalAlignment="Center" />
                        <!-- 라인 넘기기는 타임라인에 붙는다 (2026-08-22 소유자) —
                             고르기·속도·재생이 한 줄에 서야 손이 판을 안 가로지른다. -->
                        <ContentControl Grid.Column="4"
                                        x:Name="LineStepHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="6"
                                        x:Name="PlaybackTrailingHost"
                                        VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="3"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />

                <!-- 조절창이 붙박이가 됐다 (2026-08-22 소유자: "화면을 클릭했을 때 나오는
                     콘솔이 연출 프리뷰 오른쪽에 상시 표시되면 좋겠어. 챕터그래프와
                     연출그래프에서처럼") — 무대 위를 덮던 팝업이 제 기둥을 얻었다.
                     내용은 팝업 시절과 <b>같은 함수</b>가 짓는다(StageSceneView.
                     BuildStagePopover) — 담는 그릇만 바뀌었다. -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1,0,0,0">
                    <ContentControl x:Name="ConsoleHost" />
                </Border>
            </Grid>

            <!-- 알림·경고 — 뜨는 것은 좋으나 무대를 밀지 않는다 (2026-08-21 소유자:
                 "경고문구 뜨는건 좋은데, 레이아웃을 건드리진 않게"). 자리를 늘 비워 두고
                 길어지면 이 안에서 스크롤한다.
                 오른쪽 [진단 복사]는 같은 날 소유자 요청("이런 문구를 복사할 수 있도록") —
                 줄 하나는 드래그(SelectableTextBlock), 전부는 이 단추가 들고 간다. -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  Height="46"
                  Margin="0,6,0,0">
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4">
                        <StackPanel x:Name="NoticeHost" Spacing="2" />
                        <StackPanel x:Name="UnhandledHost" Spacing="2" IsVisible="False" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="1"
                        x:Name="CopyDiagnosticsButton"
                        Content="진단 복사"
                        FontSize="10"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        IsVisible="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
