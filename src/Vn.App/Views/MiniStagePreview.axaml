<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="무대 프리뷰"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           x:Name="ContextText"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        x:Name="BackgroundsRootButton"
                        Content="배경 폴더…"
                        FontSize="10"
                        Padding="6,2" />
                <Button Grid.Column="3"
                        x:Name="PortraitsRootButton"
                        Content="초상화 폴더…"
                        FontSize="10"
                        Padding="6,2"
                        Margin="4,0,0,0" />
                <Button Grid.Column="4"
                        x:Name="RefreshButton"
                        Content="새로 고침"
                        FontSize="10"
                        Padding="6,2"
                        Margin="4,0,0,0" />
            </Grid>

            <StackPanel Grid.Row="1"
                        x:Name="BadgeRow"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,6,0,0" />

            <Panel Grid.Row="2" Margin="0,6,0,0">
                <Border x:Name="StageHost"
                        Height="185"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="#FF3A3A3E">
                    <Panel>
                        <Image x:Name="BackgroundImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="BackgroundKeyText"
                                   FontSize="11"
                                   Opacity="0.85"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0" />
                        <TextBlock x:Name="OffStageSpeakerText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Background="#88000000"
                                   Padding="6,2"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="6,6,0,0" />
                        <!-- 좌표 재현이 아니다 — 슬롯 키 순서의 균등 나열임이 보이도록 중앙 정렬 한 줄이다. -->
                        <StackPanel x:Name="PortraitRow"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,6" />
                        <TextBlock x:Name="StageEmptyText"
                                   FontSize="11"
                                   Opacity="0.75"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Panel>
                </Border>
            </Panel>

            <StackPanel Grid.Row="3" Spacing="4" Margin="0,6,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            x:Name="BoxKindBadge"
                            Background="#232563EB"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="BoxKindText" FontSize="10" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Name="LineText"
                               FontSize="12"
                               Margin="8,0,0,0"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel x:Name="NoticeHost" Spacing="2" />
                <StackPanel x:Name="UnhandledHost" Spacing="2" IsVisible="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
