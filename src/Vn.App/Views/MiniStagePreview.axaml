<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <!-- 무대 프리뷰 판 (2026-08-20 중앙 탭 승격) — 좌: 대본 터미널, 우: 무대.
         예전의 "창으로 열기"·"접기"는 탭이 대체했다.
         ⛔ 판을 감싸던 Border Padding(14,10)은 2026-08-26에 걷었다 (소유자: "그래프가
         시작하는 라인과 … 프리뷰가 시작하는 지점의 윗부분 라인이 일치하도록") — 골격이
         두 그래프와 같은 [툴바 Border | 내용 | 하단 보고] 셋이 됐다. -->
    <Grid RowDefinitions="Auto,*,Auto">
            <!-- ⛔ "무대 프리뷰 · 연출: …" 글줄은 2026-08-26에 걷었다 (소유자: "이런 글자를
                 없애주십시오") — 탭 이름이 이미 제목이고, 연출 이름은 씬 선택기가 말한다.
                 ⚠ 이 툴바는 챕터 그래프·연출 그래프의 것과 <b>한 쌍</b>이다 (같은 날 소유자:
                 "챕터 드롭다운창의 크기와 위치를 통일해라") — 같은 Border(Padding 10,8 ·
                 아래 구분선), 같은 StackPanel(Spacing=6) · 라벨 여백 · 콤보 치수.
                 한쪽을 고치면 셋 다 고친다.
                 뱃지·갈래 칩도 여기 오른쪽에 산다 (같은 날 소유자: "챕터목록 아래로 1줄이
                 통째로 텅 비어있는데") — 제 줄 하나를 늘 차지하던 것을 툴바가 품는다. -->
            <Border Grid.Row="0"
                    Padding="10,8"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="챕터"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <ComboBox x:Name="ChapterCombo" MinWidth="180" FontSize="11"
                                  ToolTip.Tip="씬 선택기가 이 챕터의 씬만 담습니다. 다른 탭의 챕터 선택과 같은 값을 봅니다." />
                        <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                    </StackPanel>
                    <!-- 간격은 StageIndicators가 마진으로 준다 (W37). 많아져 줄바꿈하면
                         툴바가 그만큼 자란다 — 드문 일이라 빈 줄을 상시로 들고 있는 것보다 낫다. -->
                    <WrapPanel Grid.Column="1"
                               x:Name="BadgeRow"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 좌: 연출 대본 텍스트 패널(위) + 선택 대상 작업대(아래) · 우: 무대.
                 무대 그리기는 StageSceneView 하나다(렌더 사본 금지).
                 터미널:작업대 영역비는 가로 스플리터 드래그로 조절한다 (2026-08-21 소유자:
                 "높이에 따라 범위가 자꾸 변하는데 조작감이 너무 별로" — 고정 높이 + 내부 스크롤).
                 작업대는 <b>비어 있어도 접지 않는다</b>(같은 날: 클릭마다 레이아웃이 움직이던
                 원인) — 사람이 스플리터로 정한 비율만이 이 높이를 바꾼다. -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="380,10,*,6,340"
                  Margin="14,8,14,10">
                <Grid Grid.Column="0"
                      x:Name="LeftColumn"
                      RowDefinitions="Auto,*,8,260">
                    <!-- 씬 선택기 (2026-08-21 소유자) — "미리 다 해둔 다음에 무대
                         프리뷰측에서 뭘 할지 고르도록". 에피소드(📄)·커스텀 씬(✎)을
                         고르면 연출 채널이 자동으로 서고(발행·연결 전부) 터미널이 채워진다. -->
                    <ComboBox Grid.Row="0"
                              x:Name="SceneCombo"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="연출할 씬 선택 — 에피소드·커스텀 씬" />
                    <ContentControl Grid.Row="1"
                                    x:Name="ScriptHost" />
                    <GridSplitter Grid.Row="2"
                                  x:Name="DetailSplitter"
                                  ResizeDirection="Rows"
                                  Background="{DynamicResource ThemeBorderLowBrush}" />
                    <ScrollViewer Grid.Row="3"
                                  x:Name="DetailScroll"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="DetailHost"
                                        Margin="2,4,10,4" />
                    </ScrollViewer>
                </Grid>
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />
                <!-- 무대 + 아래 재생 줄 (2026-08-21 소유자: "재생이 프리뷰 아래쪽에 오는게
                     더 좋아보여. 타임라인이랑 같이") — 재생 컨트롤(W31)과 프레임 타임라인이
                     무대 바로 밑에 나란히 선다. -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <ContentControl Grid.Row="0"
                                    x:Name="SceneHost" />
                    <!-- 재생 줄 높이도 고정 — 타임라인이 있는 라인과 없는 라인 사이에서
                         무대 크기가 바뀌지 않는다.

                         자리로 무게를 가른다 (2026-08-21 소유자: "타임라인 가장 오른쪽으로
                         보내서 위치상 안 겹치게"): 왼쪽은 지금 다듬는 라인의 것([▶ 라인]·
                         진행), 오른쪽 끝은 가끔 쓰는 것(노드 전체 재생·배속). 타임라인이
                         가운데를 채우며 둘을 벌려 놓는다. -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,16,*,10,Auto,14,Auto"
                          Height="34"
                          Margin="0,8,0,0">
                        <ContentControl Grid.Column="0"
                                        x:Name="PlaybackHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="2"
                                        x:Name="TimelineHost"
                                        VerticalAlignment="Center" />
                        <!-- 라인 넘기기는 타임라인에 붙는다 (2026-08-22 소유자) —
                             고르기·속도·재생이 한 줄에 서야 손이 판을 안 가로지른다. -->
                        <ContentControl Grid.Column="4"
                                        x:Name="LineStepHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="6"
                                        x:Name="PlaybackTrailingHost"
                                        VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="3"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />

                <!-- 조절창이 붙박이가 됐다 (2026-08-22 소유자: "화면을 클릭했을 때 나오는
                     콘솔이 연출 프리뷰 오른쪽에 상시 표시되면 좋겠어. 챕터그래프와
                     연출그래프에서처럼") — 무대 위를 덮던 팝업이 제 기둥을 얻었다.
                     내용은 팝업 시절과 <b>같은 함수</b>가 짓는다(StageSceneView.
                     BuildStagePopover) — 담는 그릇만 바뀌었다. -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="*,Auto">
                        <ContentControl x:Name="ConsoleHost" />
                        <!-- 에셋 탐색기 자리 (2026-08-26 소유자: "에셋이 연출그래프에
                             있는데, 그게 무대프리뷰로 옮겨와줘") — 에셋을 보며 고르는
                             화면이 무대라서다. 자리만 이 뷰가 내주고 내용(AssetExplorerView)은
                             셸이 꽂는다 — 배선이 세션·탐색기 새로 고침과 얽혀 있다. -->
                        <ContentControl Grid.Row="1" x:Name="AssetHost" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 연출 보고 — 챕터 그래프의 검증 보고와 같은 문법이다 (2026-08-26 소유자:
                 "'반영 안 될 연출 1' … 챕터 그래프처럼 아래쪽에서 경고로 접혀진 상태로
                 표시되었다가, 오른쪽의 펼치기 버튼으로 펴면 상세하게"). 머리글이 요약
                 (반영 안 된 연출·미표시·알림 수)을 들고, 펴면 미반영 상세와 알림이 선다.
                 예전의 상시 46px 띠와 위 뱃지 줄의 토글 뱃지가 이 하나로 합쳐졌다.
                 ⚠ 줄들은 SelectableTextBlock 그대로다 — [진단 복사] 단추가 걷힌 뒤
                 드래그가 유일한 복사 통로다.
                 ⚠ 머리글 높이 리소스 셋은 챕터 그래프의 것과 같은 값이다 — Fluent의
                 48px 기본을 Style로는 못 줄여 리소스를 갈아 끼운다(그쪽 주석 참조). -->
            <!-- 창 가장자리에 딱 붙는다 (2026-08-26 소유자: "좌우아래쪽 공간이 붕
                 떠있는데 … 딱 붙여줘. 챕터그래프에서했던 것 처럼") — 판의 바깥 여백이
                 걷혀 검증 보고와 같은 자리 잡기가 됐다. -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,1,0,0">
                <Expander x:Name="StageReportExpander"
                          Header="연출 보고"
                          Padding="0"
                          FontSize="11"
                          HorizontalAlignment="Stretch">
                    <Expander.Resources>
                        <x:Double x:Key="ExpanderMinHeight">26</x:Double>
                        <Thickness x:Key="ExpanderHeaderPadding">10,2</Thickness>
                        <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                    </Expander.Resources>
                    <ScrollViewer MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel Margin="10,6" Spacing="4">
                            <StackPanel x:Name="UnhandledHost" Spacing="2" />
                            <StackPanel x:Name="NoticeHost" Spacing="2" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Border>
    </Grid>
</UserControl>
