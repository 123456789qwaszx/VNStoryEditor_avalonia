<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Vn.App.Views"
        x:Class="Vn.App.MainWindow"
        Width="1400"
        Height="880"
        MinWidth="1000"
        MinHeight="640"
        Title="VnTool">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,16,Auto,Auto,16,Auto,Auto,16,*,Auto">
                <Button Grid.Column="0" x:Name="NewButton" Content="새 프로젝트" />
                <Button Grid.Column="1" x:Name="OpenButton" Content="열기…" Margin="6,0,0,0" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="저장" Margin="6,0,0,0" />
                <Button Grid.Column="3" x:Name="SaveAsButton" Content="다른 이름으로…" Margin="6,0,0,0" />

                <Button Grid.Column="5" x:Name="UndoButton" Content="실행 취소" />
                <Button Grid.Column="6" x:Name="RedoButton" Content="다시 실행" Margin="6,0,0,0" />

                <Button Grid.Column="8" x:Name="ExportButton" Content="내보내기…" />
                <Button Grid.Column="9" x:Name="CsvExportButton" Content="CSV 내보내기…" Margin="6,0,0,0" />

                <StackPanel Grid.Column="11" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="ProjectNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProjectPathText" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="12"
                           x:Name="DirtyText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="12,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="240,6,*,6,460">
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0"
                            Padding="12,10"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="시나리오 파일" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActiveFileSummaryText"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="54,*"
                          Margin="10,8,10,4">
                        <TextBlock Grid.Column="0"
                                   Text="그래프"
                                   FontSize="10"
                                   Opacity="0.55"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="현재 작업 파일"
                                   FontSize="10"
                                   Opacity="0.55" />
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FileListPanel"
                                    Margin="8,0,8,10"
                                    Spacing="4" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <views:GraphEditorView Grid.Column="2" x:Name="Graph" />

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <Border Grid.Column="4"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1,0,0,0">
                <Panel>
                    <views:DialogueNodeEditor x:Name="DialogueEditor" />
                    <views:SetNodeEditor x:Name="SetEditor" />
                    <views:PresentationNodeEditor x:Name="PresentationEditor" />
                    <views:CommandSupplyNodeEditor x:Name="SupplyEditor" />
                    <TextBlock x:Name="EmptyText"
                               Text="노드를 선택하면 여기서 편집합니다."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
