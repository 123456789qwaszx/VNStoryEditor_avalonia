<?xml version="1.0" encoding="utf-8"?>
<!--
  배포용 exe 하나 (2026-08-17).

    dotnet publish src/Vn.App -p:PublishProfile=win-x64

  받는 사람은 **.NET을 설치하지 않는다** — SelfContained가 런타임을 exe 안에 넣는다.
  그래서 파일이 크다(≈78MB). 압축을 켜서 절반쯤 줄였고, ReadyToRun으로 첫 창이 뜨는
  시간을 줄였다 — 둘은 서로 반대 방향이라 "작게"와 "빠르게" 사이에서 이 조합을 골랐다.

  <b>트리밍(PublishTrimmed)은 켜지 않는다.</b> Avalonia의 XAML 로딩과 ClosedXML·System.Text.Json이
  리플렉션으로 형식을 찾는데, 트리머는 그 참조를 못 보고 지운다. 지워진 것은 빌드가 아니라
  <b>실행 중에</b> 드러난다 — 받는 사람의 화면에서 처음 터지는 종류의 고장이다.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <!-- Skia·HarfBuzz 같은 네이티브 라이브러리도 exe 안에 넣는다. 끄면 .dll 여럿이
         exe 옆에 남고, 그중 하나만 빠져도 "왜 안 켜지지"가 된다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
